+            (
+                false,
+                true,
+                false,
+                "tablet",
+                vec![
+                    "simplefb_touch",
+                    "simplefb_tablet",
+                    "simplefb_mouse",
+                    "simplefb_keyboard",
+                ],
+            ),
+            (
+                true,
+                false,
+                false,
+                "",
+                vec!["multi_touch", "window_mouse", "window_keyboard"],
+            ),
+            (
+                true,
+                true,
