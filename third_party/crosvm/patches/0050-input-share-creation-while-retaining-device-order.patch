+    fn desktop_and_linux_input_keep_their_device_sets() {
+        use super::*;
+        let saved_mode = std::env::var_os("CROSVM_GVM_INPUT_MODE");
+        for (legacy, simplefb, vnc, mode, expected) in [
+            (
+                false,
+                false,
+                false,
+                "tablet",
+                vec![
+                    "multi_touch",
+                    "window_tablet",
+                    "window_mouse",
+                    "window_keyboard",
+                ],
