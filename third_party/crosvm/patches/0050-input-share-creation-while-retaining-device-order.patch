+                        b"DroidVM Keyboard (gpu-0)".as_slice()
+                    } else {
+                        b"DroidVM VNC Keyboard".as_slice()
+                    }
+                );
+            }
+        }
+        match saved_mode {
+            Some(mode) => std::env::set_var("CROSVM_GVM_INPUT_MODE", mode),
+            None => std::env::remove_var("CROSVM_GVM_INPUT_MODE"),
+        }
+    }
