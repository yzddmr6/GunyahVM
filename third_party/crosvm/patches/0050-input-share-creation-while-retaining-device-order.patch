+/// Window input shared by the GPU and firmware framebuffer. Device identities and
+/// ordering remain those of the existing Linux and shared desktop profiles.
+#[cfg(feature = "gpu")]
+fn create_display_input(
+    cfg: &Config,
+    devs: &mut Vec<(&'static str, VirtioDeviceStub)>,
+    width: u32,
+    height: u32,
+    simplefb: bool,
+) -> DeviceResult<Vec<EventDevice>> {
+    let legacy = cfg.prepare_lend_mthp.is_some();
+    let vnc = legacy && cfg.vnc_server.is_some();
+    let mut event_devices = Vec::new();
+    if !vnc && (cfg.display_window_mouse || (simplefb && !legacy)) {
+        let mut width = width;
+        let mut height = height;
+        let mut name = if simplefb {
+            Some("gvm simplefb touch")
+        } else {
+            None
+        };
+        if !simplefb {
+            for input in &cfg.virtio_input {
+                if let InputDeviceOption::MultiTouch {
+                    width: w,
+                    height: h,
+                    name: n,
+                    ..
+                } = input
+                {
+                    if let Some(w) = w {
+                        width = *w;
+                    }
+                    if let Some(h) = h {
+                        height = *h;
+                    }
+                    if let Some(n) = n {
+                        name = Some(n.as_str());
+                    }
+                    break;
+                }
+            }
+        }
+        if legacy {
+            name = Some("DroidVM VNC Touch");
+        }
+        let idx = if simplefb && !legacy {
+            u32::MAX - 2
+        } else {
+            u32::MAX
+        };
+        let (event_socket, virtio_socket) =
+            StreamChannel::pair(BlockingMode::Nonblocking, FramingMode::Byte)
+                .context("failed to create touch socket")?;
+        let dev = virtio::input::new_multi_touch(
+            idx,
+            virtio_socket,
+            width,
+            height,
+            name,
+            virtio::base_features(cfg.protection_type),
+        )?;
+        devs.push((
+            if simplefb && !legacy {
+                "simplefb_touch"
+            } else {
+                "multi_touch"
+            },
+            VirtioDeviceStub {
+                dev: Box::new(dev),
+                jail: simple_jail(cfg.jail_config.as_ref(), "input_device")?,
+            },
+        ));
+        event_devices.push(EventDevice::touchscreen(event_socket));
+        gvm_pointer_devices(
+            cfg,
+            devs,
+            &mut event_devices,
+            width,
+            height,
+            if simplefb { u32::MAX - 6 } else { u32::MAX - 4 },
+            if simplefb { "simplefb" } else { "window" },
+        )?;
+    } else if vnc {
+        gvm_pointer_devices(
+            cfg,
+            devs,
+            &mut event_devices,
+            width,
+            height,
+            u32::MAX - 1,
+            "window",
+        )?;
+    }
+    if cfg.display_window_keyboard || (simplefb && !legacy) || vnc {
+        let idx = if vnc {
+            u32::MAX - 1
+        } else if simplefb && !legacy {
+            u32::MAX - 3
+        } else {
+            u32::MAX
+        };
+        let (event_socket, virtio_socket) =
+            StreamChannel::pair(BlockingMode::Nonblocking, FramingMode::Byte)
+                .context("failed to create keyboard socket")?;
+        let mut dev = virtio::input::new_keyboard(
+            idx,
+            virtio_socket,
+            virtio::base_features(cfg.protection_type),
+        )?;
+        if legacy {
+            dev.set_identity(
+                if vnc {
+                    "DroidVM Keyboard (gpu-0)"
+                } else {
+                    "DroidVM VNC Keyboard"
+                },
+                format!("virtio-keyboard-{idx}"),
+            );
+        }
+        devs.push((
+            if vnc {
+                "vnc_keyboard"
+            } else if simplefb && !legacy {
+                "simplefb_keyboard"
+            } else {
+                "window_keyboard"
+            },
+            VirtioDeviceStub {
+                dev: Box::new(dev),
+                jail: simple_jail(cfg.jail_config.as_ref(), "input_device")?,
+            },
+        ));
+        event_devices.push(EventDevice::keyboard(event_socket));
+    }
+    Ok(event_devices)
+}
