+                "tablet",
+                vec![
+                    "multi_touch",
+                    "window_tablet",
+                    "window_mouse",
+                    "window_keyboard",
+                ],
+            ),
+            (
+                true,
+                false,
+                true,
+                "tablet",
+                vec!["vnc_tablet", "vnc_keyboard"],
+            ),
+        ] {
+            std::env::set_var("CROSVM_GVM_INPUT_MODE", mode);
+            let mut cfg = Config::default();
+            cfg.jail_config = None;
+            cfg.display_window_mouse = !vnc;
+            cfg.display_window_keyboard = !vnc;
+            if legacy {
+                cfg.prepare_lend_mthp = Some(crate::crosvm::config::LendMthpMode::Single);
+            }
+            if vnc {
+                cfg.vnc_server = Some(serde_keyvalue::from_key_values("host=127.0.0.1").unwrap());
+            }
+            let mut devs = Vec::new();
+            let events = create_display_input(&cfg, &mut devs, 1280, 800, simplefb).unwrap();
+            assert_eq!(
+                devs.iter().map(|(name, _)| *name).collect::<Vec<_>>(),
+                expected
+            );
+            assert_eq!(events.len(), devs.len());
+            if legacy {
+                let mut data = [0; 128];
+                let (_, keyboard) = devs.last_mut().unwrap();
+                keyboard.dev.write_config(0, &[1, 0]);
+                keyboard.dev.read_config(8, &mut data);
+                let end = data.iter().position(|b| *b == 0).unwrap_or(data.len());
+                assert_eq!(
+                    &data[..end],
