@@ -996,6 +1136,96 @@ mod tests {
     use super::*;
     use crate::suspendable_tests;
 
+    struct RelocatableBar {
+        base: u64,
+        decode: bool,
+        tag: u8,
+    }
+    impl Suspendable for RelocatableBar {}
+    impl BusDevice for RelocatableBar {
+        fn device_id(&self) -> DeviceId {
+            PciId::new(0x1af4, 0x1000).into()
+        }
+        fn debug_label(&self) -> String {
+            "relocatable BAR".into()
+        }
+        fn read(&mut self, _: BusAccessInfo, data: &mut [u8]) {
+            data.fill(self.tag);
+        }
+        fn get_ranges(&self) -> Vec<(BusRange, BusType)> {
+            vec![(
+                BusRange {
+                    base: self.base,
+                    len: 0x1000,
+                },
+                BusType::Mmio,
+            )]
+        }
+        fn config_register_read(&self, _: usize) -> u32 {
+            if self.decode {
+                COMMAND_REG_MEMORY_SPACE_MASK
+            } else {
+                0
+            }
+        }
+        fn config_register_write(
+            &mut self,
+            _: usize,
+            _: u64,
+            data: &[u8],
+        ) -> crate::bus::ConfigWriteResult {
+            let old = BusRange {
+                base: self.base,
+                len: 0x1000,
+            };
+            self.base = u32::from_le_bytes(data.try_into().unwrap()) as u64;
+            let mut result = crate::bus::ConfigWriteResult::default();
+            if self.decode {
+                result.mmio_remove.push(old);
+                result.mmio_add.push(BusRange {
+                    base: self.base,
+                    len: 0x1000,
+                });
+            }
+            result
+        }
+    }
+
+    #[test]
+    fn bar_move_waits_for_the_previous_decoder() {
+        for decode in [true, false] {
+            let bus = Arc::new(Bus::new(BusType::Mmio));
+            let io = Arc::new(Bus::new(BusType::Io));
+            let mut root = PciRoot::create_for_test(
+                Arc::downgrade(&bus),
+                GuestAddress(0),
+                0,
+                Arc::downgrade(&io),
+                Arc::new(Mutex::new(PciBus::new(0, 0, false))),
+            );
+            let a: PciAddress = "00:01.0".parse().unwrap();
+            let b: PciAddress = "00:02.0".parse().unwrap();
+            for (address, base, tag, enabled) in [(a, 0x1000, 1, true), (b, 0x2000, 2, decode)] {
+                let dev: Arc<Mutex<dyn BusDevice>> = Arc::new(Mutex::new(RelocatableBar {
+                    base,
+                    decode: enabled,
+                    tag,
+                }));
+                bus.insert(dev.clone(), base, 0x1000).unwrap();
+                root.devices.insert(address, dev);
+            }
+            root.config_space_write(a, 4, 0, &0x2000u32.to_le_bytes());
+            let mut data = [0];
+            assert!(bus.read(0x2000, &mut data));
+            assert_eq!(data, [2]);
+            root.config_space_write(b, 4, 0, &0x3000u32.to_le_bytes());
+            assert!(bus.read(0x2000, &mut data));
+            assert_eq!(data, [1]);
+            assert!(!bus.read(0x1000, &mut data));
+            assert_eq!(bus.read(0x3000, &mut data), decode);
+        }
+    }
+
     fn create_pci_root() -> Arc<Mutex<PciRoot>> {
         let io_bus = Arc::new(Bus::new(BusType::Io));
         let mmio_bus = Arc::new(Bus::new(BusType::Mmio));
