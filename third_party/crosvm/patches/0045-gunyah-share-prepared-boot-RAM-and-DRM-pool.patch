+/// Populate and pin the mapping used by the boot shim and fixed DRM pool.
+#[cfg(target_arch = "aarch64")]
+unsafe fn prepare_boot_mapping(base: *mut u8, size: usize) -> Result<()> {
+    const THP_SIZE: usize = 2 << 20;
+    const MADV_POPULATE_WRITE: i32 = 23;
+    const MADV_COLLAPSE: i32 = 25;
+    libc::madvise(base.cast(), size, libc::MADV_HUGEPAGE);
+    if libc::madvise(base.cast(), size, MADV_POPULATE_WRITE) != 0 {
+        return Err(Error::last());
+    }
+    let mut collapsed = 0;
+    for offset in (0..size).step_by(THP_SIZE) {
+        if libc::madvise(base.add(offset).cast(), THP_SIZE, MADV_COLLAPSE) == 0 {
+            collapsed += 1;
+        }
+    }
+    info!(
+        "Gunyah boot mapping: {} of {} windows backed by 2 MiB folios",
+        collapsed,
+        size / THP_SIZE
+    );
+    if libc::mlock(base.cast(), size) != 0 {
+        return Err(Error::last());
+    }
+    let ctr: u64;
+    std::arch::asm!("mrs {ctr}, ctr_el0", ctr = out(reg) ctr);
+    let line_size = 4usize << ((ctr >> 16) & 0xf);
+    for offset in (0..size).step_by(line_size) {
+        std::arch::asm!("dc civac, {addr}", addr = in(reg) base.add(offset), options(nostack));
+    }
+    std::arch::asm!("dsb sy", options(nostack));
+    Ok(())
+}
