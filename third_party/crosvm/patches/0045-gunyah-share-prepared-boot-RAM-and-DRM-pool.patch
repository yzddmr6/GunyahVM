+
+    #[test]
+    fn shim_failure_notifies_run_loop() {
+        for status in [shim_abi::SHIM_STATUS_ERROR, shim_abi::SHIM_STATUS_JUMPING] {
+            let mem = GuestMemory::new(&[(GuestAddress(0), 4096)]).unwrap();
+            mem.write_obj_at_addr(
+                status,
+                GuestAddress(std::mem::offset_of!(shim_abi::ShimHandoff, status) as u64),
+            )
+            .unwrap();
+            let (sender, receiver) = std::sync::mpsc::channel();
+            watch_shim(mem, GuestAddress(0), move || sender.send(()).unwrap())
+                .unwrap()
+                .join()
+                .unwrap();
+            assert_eq!(
+                receiver.recv().is_ok(),
+                status == shim_abi::SHIM_STATUS_ERROR
+            );
+        }
+    }
