             self.create_surface(display, parent_surface_id, None)?;
@@ -360,6 +364,7 @@ impl VirtioGpuScanout {
     }
 
     fn release_surface(&mut self, display: &Rc<RefCell<GpuDisplay>>) {
+        self.deferred_resource = None;
         if let Some(surface_id) = self.surface_id {
             display.borrow_mut().release_surface(surface_id);
         }
@@ -434,15 +439,10 @@ impl VirtioGpuScanout {
         // Import failed, fall back to a copy.
         let mut display = display.borrow_mut();
 
-        // Prevent overwriting a buffer that is currently being used by the compositor.
-        // iceland gvm: remember the dropped frame; the worker's retry timer presents it once a buffer is
-        // free (vm-run v10b: the last frame of a burst was dropped and an idle guest never flushed again,
-        // so the window kept an old, often black, frame).
         if display.next_buffer_in_use(surface_id) {
-            super::gvm_scanout::dropped(resource.resource_id);
+            self.deferred_resource = NonZeroU32::new(resource.resource_id);
             return Ok(OkNoData);
         }
-
         let fb = display
             .framebuffer_region(surface_id, 0, 0, self.width, self.height)
             .ok_or(ErrUnspec)?;
@@ -464,7 +464,7 @@ impl VirtioGpuScanout {
         );
 
         display.flip(surface_id);
-        super::gvm_scanout::presented(resource.resource_id);
+        self.deferred_resource = None;
         Ok(OkNoData)
     }
 
@@ -839,6 +839,21 @@ impl VirtioGpu {
             }
         }
 
+        drop(display);
+        // A callback and a buffer release can arrive separately. Keep the latest
+        // guest damage pending until both the surface and its buffer are ready.
+        for scanout in self.scanouts.values_mut().chain(std::iter::once(&mut self.cursor_scanout)) {
+            if let Some(id) = scanout.deferred_resource.take() {
+                if scanout.resource_id == Some(id) {
+                    if let Some(resource) = self.resources.get_mut(&id.get()) {
+                        if let Err(e) = scanout.flush(&self.display, resource, &mut self.rutabaga) {
+                            error!("could not present deferred frame: {:?}", e);
+                        }
+                    }
+                }
+            }
+        }
+
         ProcessDisplayResult::Success
     }
 
@@ -861,15 +876,10 @@ impl VirtioGpu {
 
     /// iceland gvm: flush every resource that is currently on a scanout once more (refresh timer).
     pub fn gvm_refresh_scanouts(&mut self) {
-        // CROSVM_GVM_REFRESH_MS set: re-present every scanout; otherwise only a frame the copy path had to
-        // drop (compositor still held the next buffer)
-        let all = super::gvm_scanout::refresh_all();
-        let pending = super::gvm_scanout::take_dropped();
         let ids: Vec<u32> = self
             .scanouts
             .values()
             .filter_map(|s| s.resource_id.map(|r| r.get()))
-            .filter(|&r| all || pending == Some(r))
             .collect();
         for id in ids {
             let _ = self.flush_resource(id);
diff --git a/gpu_display/src/display_wl.c b/gpu_display/src/display_wl.c
