+/// Reattach a surviving VM to a replacement local Wayland compositor.
+pub fn do_gpu_display_reconnect<T: AsRef<Path> + std::fmt::Debug>(
+    control_socket_path: T, socket_path: std::path::PathBuf,
+) -> ModifyGpuResult {
+    let request = VmRequest::GpuCommand(GpuControlCommand::ReconnectDisplay { socket_path });
+    handle_request(&request, control_socket_path)
+        .map_err(|_| ModifyGpuError::SocketFailed)?.into()
+}
