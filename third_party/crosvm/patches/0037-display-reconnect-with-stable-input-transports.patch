+    fn track_input(&mut self, event: &virtio_input_event) {
+        let code = event.code.to_native();
+        let value = event.value.to_native();
+        match event.type_.to_native() {
+            linux_input_sys::constants::EV_KEY if code <= linux_input_sys::constants::KEY_MAX => {
+                if value == 0 { self.pressed_keys.remove(&code); }
+                else { self.pressed_keys.insert(code); }
+            }
+            linux_input_sys::constants::EV_ABS if code == linux_input_sys::constants::ABS_MT_SLOT => self.current_slot = value,
+            linux_input_sys::constants::EV_ABS if code == linux_input_sys::constants::ABS_MT_TRACKING_ID => {
+                if value < 0 { self.active_slots.remove(&self.current_slot); }
+                else if (0..10).contains(&self.current_slot) { self.active_slots.insert(self.current_slot); }
+            }
+            _ => (),
+        }
+    }
+
+    /// Focus or compositor loss must not leave held keys/buttons/touches in
+    /// the guest. Queue releases after pending reports, including backpressure.
+    /// This exceptional queue extension is bounded by KEY_MAX + 20 MT events.
+    pub fn release_pressed(&mut self) -> io::Result<bool> {
+        let mut events: Vec<_> = std::mem::take(&mut self.pressed_keys).into_iter()
+            .map(|key| virtio_input_event::key(key, false, false)).collect();
+        for slot in std::mem::take(&mut self.active_slots) {
+            events.push(virtio_input_event::multitouch_slot(slot));
+            events.push(virtio_input_event::multitouch_tracking_id(-1));
+        }
+        events.push(virtio_input_event::syn());
+        for event in events { self.event_buffer.extend(event.as_bytes()); }
         self.flush_buffered_events()
     }
 
