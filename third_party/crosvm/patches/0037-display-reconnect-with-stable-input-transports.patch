+    fn reconnect_display(&mut self, socket_path: &std::path::Path) -> GpuControlResult {
+        let next = match GpuDisplay::open_wayland(Some(socket_path)) {
+            Ok(display) => display,
+            Err(e) => return GpuControlResult::ErrString(e.to_string()),
+        };
+        let scanouts: Vec<_> = self.scanouts.iter().map(|(id, s)| (*id, s.snapshot())).collect();
+        let cursor = self.cursor_scanout.snapshot();
+        self.cursor_scanout.release_surface(&self.display);
+        for scanout in self.scanouts.values_mut() {
+            scanout.release_surface(&self.display);
+        }
+        for resource in self.resources.values_mut() {
+            for (surface, import) in std::mem::take(&mut resource.display_import) {
+                self.display.borrow_mut().release_import(import, surface);
+            }
+        }
+        if let Err(e) = self.display.borrow_mut().replace_connection(next) {
+            return GpuControlResult::ErrString(e.to_string());
+        }
+        for (id, snapshot) in scanouts {
+            if let Err(e) = self.scanouts.get_mut(&id).unwrap().restore(snapshot, None, &self.display) {
+                return GpuControlResult::ErrString(format!("restore scanout: {:?}", e));
+            }
+        }
+        let parent = cursor.parent_scanout_id.and_then(|id| self.scanouts.get(&id)).and_then(|s| s.surface_id);
+        if let Err(e) = self.cursor_scanout.restore(cursor, parent, &self.display) {
+            return GpuControlResult::ErrString(format!("restore cursor: {:?}", e));
+        }
+        let resources: Vec<_> = self.scanouts.values().filter_map(|s| s.resource_id).collect();
+        for id in resources { let _ = self.flush_resource(id.into()); }
+        GpuControlResult::DisplayReconnected
+    }
