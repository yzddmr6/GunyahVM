+#[cfg(test)]
+mod pool_tests {
+    use super::*;
+    use crate::virtio::descriptor_utils::{create_descriptor_chain, DescriptorType};
+    use vm_memory::{GuestAddress, GuestMemory};
+
+    #[test]
+    fn pool_map_response_carries_the_existing_byte_offset() {
+        let mem = GuestMemory::new(&[(GuestAddress(0), 0x1000)]).unwrap();
+        let mut desc = create_descriptor_chain(
+            &mem,
+            GuestAddress(0x100),
+            GuestAddress(0x400),
+            vec![(DescriptorType::Writable, 32)],
+            0,
+        )
+        .unwrap();
+        let reply = GpuResponse::OkMapInfo {
+            map_info: VIRTIO_GPU_MAP_INFO_POOL | 1,
+            pool_offset: Some(0x1234000),
+        };
+        assert_eq!(reply.encode(0, 0, 0, 0, &mut desc.writer).unwrap(), 32);
+        let got: virtio_gpu_resp_map_info = mem.read_obj_from_addr(GuestAddress(0x400)).unwrap();
+        assert_eq!(got.map_info.to_native(), 0x80000001);
+        assert_eq!(u32::from_le(got.padding), 0x1234000);
+    }
+}
