+//! Replay desktop boot requests through the real decoder, frontend and response encoder.
+//! The CPU renderer and stub display exclude host GPU and compositor dependencies.
+use super::super::{FenceState, Frontend, VirtioGpuRing};
+use super::*;
+use crate::virtio::descriptor_utils::{create_descriptor_chain, DescriptorType};
+use rutabaga_gfx::{RutabagaBuilder, RutabagaComponentType, RutabagaFenceHandler};
+
+fn request(
+    frontend: &mut Frontend,
+    mem: &GuestMemory,
+    label: &str,
+    kind: u32,
+    args: &[u32],
+) -> Vec<u8> {
+    let mut words = vec![kind, 0, 0, 0, 0, 0];
+    words.extend_from_slice(args);
+    let bytes: Vec<u8> = words.into_iter().flat_map(u32::to_le_bytes).collect();
+    println!(
+        "REQUEST {} {}",
+        label,
+        bytes.iter().map(|b| format!("{b:02x}")).collect::<String>()
+    );
+    mem.write_all_at_addr(&bytes, GuestAddress(0x1000)).unwrap();
+    let desc = create_descriptor_chain(
+        mem,
+        GuestAddress(0),
+        GuestAddress(0x1000),
+        vec![
+            (DescriptorType::Readable, bytes.len() as u32),
+            (DescriptorType::Writable, 4096),
+        ],
+        0,
+    )
+    .unwrap();
+    let done = frontend
+        .process_descriptor(mem, desc)
+        .expect("unfenced request must complete");
+    let mut reply = vec![0; done.len as usize];
+    mem.read_exact_at_addr(&mut reply, GuestAddress(0x1000 + bytes.len() as u64))
+        .unwrap();
+    println!(
+        "REPLAY {} {}",
+        label,
+        reply.iter().map(|b| format!("{b:02x}")).collect::<String>()
+    );
+    let status = u32::from_le_bytes(reply[..4].try_into().unwrap());
+    let expected = if label == "reset-stale-resource" {
+        0x1203
+    } else {
+        match kind {
+            0x100 => 0x1101,
+            0x10a => 0x1104,
+            _ => 0x1100,
+        }
+    };
+    assert_eq!(status, expected, "{label}");
+    if kind == 0x10a {
+        let edid = &reply[32..160];
+        assert_eq!(edid.iter().fold(0u8, |sum, b| sum.wrapping_add(*b)), 0);
+        assert_eq!(edid[20], 0x80, "digital input");
+        assert_eq!(edid[24], 0x02, "preferred timing");
+        assert_eq!(edid[126], 0, "desktop EDID has one block");
+    }
+    reply
+}
+
+#[test]
+fn desktop_boot_requests() {
+    let state = Arc::new(Mutex::new(FenceState::default()));
+    let callbacks = state.clone();
+    let handler = RutabagaFenceHandler::new(move |f| {
+        callbacks
+            .lock()
+            .completed_fences
+            .insert(VirtioGpuRing::Global, f.fence_id);
+    });
+    let display = GpuDisplay::open_stub().unwrap();
+    let mut params = vec![GpuDisplayParameters::default_with_mode(
+        DisplayMode::Windowed(1280, 800),
+    )];
+    params[0].refresh_rate = 120;
+    let mut gpu = VirtioGpu::new(
+        display,
+        params,
+        Arc::new(AtomicBool::new(false)),
+        RutabagaBuilder::new(0, handler)
+            .set_default_component(RutabagaComponentType::Rutabaga2D)
+            .build()
+            .unwrap(),
+        Arc::new(Mutex::new(None)),
+        false,
+        false,
+        false,
+        None,
+    )
+    .unwrap();
+    gpu.desktop_display = true;
+    let mut frontend = Frontend::new(gpu, state);
+    let mem = GuestMemory::new(&[(GuestAddress(0), 0x900000)]).unwrap();
+    let pixels = vec![0x5au8; 1280 * 800 * 4];
+    mem.write_all_at_addr(&pixels, GuestAddress(0x100000))
+        .unwrap();
+    request(&mut frontend, &mem, "initial-display", 0x100, &[]);
+    request(&mut frontend, &mem, "initial-edid", 0x10a, &[0, 0]);
+    for (id, width, height) in [(1, 640, 480), (2, 1280, 800)] {
+        request(
+            &mut frontend,
+            &mem,
+            &format!("create-{id}"),
+            0x101,
+            &[id, 2, width, height],
+        );
+        request(
+            &mut frontend,
+            &mem,
+            &format!("attach-{id}"),
+            0x106,
+            &[id, 1, 0x100000, 0, width * height * 4, 0],
+        );
+        request(
+            &mut frontend,
+            &mem,
+            &format!("transfer-{id}"),
+            0x105,
+            &[0, 0, width, height, 0, 0, id, 0],
+        );
+        request(
+            &mut frontend,
+            &mem,
+            &format!("scanout-{id}"),
+            0x103,
+            &[0, 0, width, height, 0, id],
+        );
+        request(
+            &mut frontend,
+            &mem,
+            &format!("flush-{id}"),
+            0x104,
+            &[0, 0, width, height, id, 0],
+        );
+        request(&mut frontend, &mem, &format!("display-{id}"), 0x100, &[]);
+        request(&mut frontend, &mem, &format!("edid-{id}"), 0x10a, &[0, 0]);
+    }
+    frontend.virtio_gpu.reset().unwrap();
+    frontend.fence_state.lock().reset();
+    request(&mut frontend, &mem, "reset-display", 0x100, &[]);
+    request(&mut frontend, &mem, "reset-edid", 0x10a, &[0, 0]);
+    request(
+        &mut frontend,
+        &mem,
+        "reset-stale-resource",
+        0x104,
+        &[0, 0, 1280, 800, 2, 0],
+    );
+    request(&mut frontend, &mem, "recreate", 0x101, &[1, 2, 1280, 800]);
+    request(
+        &mut frontend,
+        &mem,
+        "reattach",
+        0x106,
+        &[1, 1, 0x100000, 0, 1280 * 800 * 4, 0],
+    );
+    request(
+        &mut frontend,
+        &mem,
+        "retransfer",
+        0x105,
+        &[0, 0, 1280, 800, 0, 0, 1, 0],
+    );
+    request(
+        &mut frontend,
+        &mem,
+        "rescanout",
+        0x103,
+        &[0, 0, 1280, 800, 0, 1],
+    );
+    request(
+        &mut frontend,
+        &mem,
+        "reflush",
+        0x104,
+        &[0, 0, 1280, 800, 1, 0],
+    );
+    let surface = frontend.virtio_gpu.scanouts[&0].surface_id.unwrap();
+    let mut display = frontend.virtio_gpu.display.borrow_mut();
+    let fb = display.framebuffer(surface).unwrap();
+    let mut sample = [0u8; 16];
+    fb.as_volatile_slice().copy_to(&mut sample);
+    assert_eq!(sample, [0x5a; 16]);
+    println!(
+        "REPLAY pixels {}",
+        sample
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect::<String>()
+    );
+}
