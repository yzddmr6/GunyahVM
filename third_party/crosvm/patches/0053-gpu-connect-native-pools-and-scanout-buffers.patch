+    fn attach_replaces_stale_backing_in_the_owning_renderer() {
+        use super::*;
+        use std::sync::{Arc, Mutex};
+        struct Backing(Arc<Mutex<(usize, usize)>>);
+        impl RutabagaComponent for Backing {
+            fn attach_backing(&self, _: u32, vecs: &mut Vec<RutabagaIovec>) -> RutabagaResult<()> {
+                let mut state = self.0.lock().unwrap();
+                if state.0 != 0 {
+                    return Err(RutabagaError::ComponentError(libc::EINVAL));
+                }
+                if vecs[0].len == 0 {
+                    return Err(RutabagaError::ComponentError(libc::ENOMEM));
+                }
+                state.0 = vecs[0].len;
+                Ok(())
+            }
+            fn detach_backing(&self, _: u32) {
+                let mut state = self.0.lock().unwrap();
+                state.0 = 0;
+                state.1 += 1;
+            }
+        }
+        let mut r = new_2d();
+        let state = Arc::new(Mutex::new((0, 0)));
+        let component = Backing(state.clone());
+        let mut resource = component
