+#[cfg(test)]
+mod desktop_nofile_tests {
+    #[test]
+    #[ignore = "changes process limits; run in isolation"]
+    fn raises_soft_limit_for_gpu_descriptors() {
+        let original = super::max_open_files().unwrap();
+        super::set_max_open_files(libc::rlimit64 {
+            rlim_cur: 64,
+            ..original
+        })
+        .unwrap();
+        let raised = super::raise_max_open_files_to_ceiling().unwrap();
+        assert!(raised.rlim_cur >= original.rlim_max);
+        eprintln!(
+            "NOFILE initial={}/{} raised={}/{}",
+            original.rlim_cur, original.rlim_max, raised.rlim_cur, raised.rlim_max
+        );
+        let count = || std::fs::read_dir("/proc/self/fd").unwrap().count();
+        let before = count();
+        let files: Vec<_> = (0..1024)
+            .map(|_| std::fs::File::open("/dev/null").unwrap())
+            .collect();
+        assert_eq!(count(), before + 1024);
+        drop(files);
+        assert_eq!(count(), before);
+        super::set_max_open_files(original).unwrap();
+    }
+}
