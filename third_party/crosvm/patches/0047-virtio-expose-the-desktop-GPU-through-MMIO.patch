+        let started = Arc::new(AtomicBool::new(false));
+        let mem = GuestMemory::new(&[(GuestAddress(0), 4096)]).unwrap();
+        let mut dev = VirtioMmioDevice::new(mem, Box::new(Gpu(started.clone()))).unwrap();
+        dev.set_mmio_base(0x0a00_0000);
+        let info = |offset: u32| BusAccessInfo {
+            address: 0x0a00_0000 + offset as u64,
+            offset: offset as u64,
+            id: 0,
+        };
+        let mut data = [0; 4];
+        // A driver can reset queues that were prepared but never activated.
+        dev.write(info(VIRTIO_MMIO_STATUS), &3u32.to_le_bytes());
+        dev.write(info(VIRTIO_MMIO_QUEUE_SEL), &1u32.to_le_bytes());
+        dev.write(info(VIRTIO_MMIO_QUEUE_READY), &1u32.to_le_bytes());
+        dev.write(info(VIRTIO_MMIO_STATUS), &0u32.to_le_bytes());
+        dev.write(info(VIRTIO_MMIO_QUEUE_SEL), &1u32.to_le_bytes());
+        dev.read(info(VIRTIO_MMIO_QUEUE_READY), &mut data);
+        assert_eq!(u32::from_le_bytes(data), 0);
+
+        dev.read(info(VIRTIO_MMIO_DEVICE_ID), &mut data);
+        assert_eq!(u32::from_le_bytes(data), 16);
+        dev.read(info(VIRTIO_MMIO_SHM_LEN_LOW), &mut data);
+        assert_eq!(u32::from_le_bytes(data), u32::MAX);
+        dev.read(info(VIRTIO_MMIO_SHM_BASE_LOW), &mut data);
+        assert_eq!(u32::from_le_bytes(data), 0);
+        let mut pool_magic = [0; 8];
+        dev.read(info(VIRTIO_MMIO_CONFIG), &mut pool_magic);
+        assert_eq!(&pool_magic, b"DVMPOOL1");
+        assert_eq!(dev.ioevents()[1].1, 0x0a00_0050);
+        dev.write(info(VIRTIO_MMIO_QUEUE_NOTIFY), &1u32.to_le_bytes());
+        assert_eq!(
+            dev.ioevents()[1]
+                .0
+                .wait_timeout(std::time::Duration::ZERO)
+                .unwrap(),
+            base::EventWaitResult::Signaled
+        );
+        dev.on_sandboxed();
+        assert!(started.load(Ordering::SeqCst));
+    }
+}
