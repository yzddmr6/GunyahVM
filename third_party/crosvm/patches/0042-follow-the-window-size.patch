+	self->size_pending = false;
+	*width = (uint32_t)(self->want_width * scale + 0.5);
+	*height = (uint32_t)(self->want_height * scale + 0.5);
+	*scale120 = (uint32_t)(scale * 120.0 + 0.5);
+	return true;
