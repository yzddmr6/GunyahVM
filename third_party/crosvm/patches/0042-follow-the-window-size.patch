         if !need_to_create {
             return Ok(OkNoData);
@@ -361,12 +389,39 @@ impl VirtioGpuScanout {
             &display_params,
             self.scanout_type,
         )?;
+        if self.input_space != (0, 0) {
+            display.set_input_space(surface_id, self.input_space.0, self.input_space.1);
+        }
 
         self.surface_id = Some(surface_id);
 
         Ok(OkNoData)
     }
 
+    /// GunyahVM: offers the guest the window's pixel size. Returns true when that changes what the
+    /// guest is offered.
+    fn follow_window(&mut self, width: u32, height: u32, scale120: u32) -> bool {
+        let Some(params) = self.display_params.as_mut() else {
+            return false;
+        };
+        // The EDID's base timing holds 12 bits per axis; the guest driver takes at least 32.
+        let size = (width.clamp(32, 4095), height.clamp(32, 4095));
+        if self.preferred == size && self.scale120 == scale120 {
+            return false;
+        }
+        self.preferred = size;
+        self.scale120 = scale120;
+        params.mode = DisplayMode::Windowed(size.0, size.1);
+        base::warn!(
+            "GVM-FOLLOW scanout {:?}: guest display {}x{} at scale {:.3}",
+            self.scanout_id,
+            size.0,
+            size.1,
+            scale120 as f64 / 120.0
+        );
+        true
+    }
+
     fn release_surface(&mut self, display: &Rc<RefCell<GpuDisplay>>) {
         self.deferred_resource = None;
         if let Some(surface_id) = self.surface_id {
@@ -680,6 +735,8 @@ fn sglist_to_rutabaga_iovecs(
 
 pub enum ProcessDisplayResult {
     Success,
+    // GunyahVM: the guest must re-read the display configuration (config interrupt).
+    DisplaysUpdated,
     CloseRequested,
     Error(GpuDisplayError),
 }
@@ -755,7 +812,7 @@ impl VirtioGpu {
                 self.scanouts
                     .get(&scanout_id)
                     .map_or((0, 0, false), |scanout| {
-                        (scanout.width, scanout.height, true)
+                        (scanout.preferred.0, scanout.preferred.1, true)
                     })
             })
             .collect::<Vec<_>>()
@@ -909,6 +966,20 @@ impl VirtioGpu {
             }
         }
 
+        // GunyahVM: a window the guest display follows reports its pixel size once per change; the
+        // guest re-reads the display info and EDID after the config interrupt.
+        let mut displays_updated = false;
+        for scanout in self.scanouts.values_mut() {
+            if let Some(surface_id) = scanout.surface_id {
+                if let Some((width, height, scale120)) = display.take_window_size(surface_id) {
+                    displays_updated |= scanout.follow_window(width, height, scale120);
+                }
+            }
+        }
+        if displays_updated {
+            self.scanouts_updated.store(true, Ordering::Relaxed);
+        }
+
         drop(display);
         // A callback and a buffer release can arrive separately. Keep the latest
         // guest damage pending until both the surface and its buffer are ready.
@@ -924,7 +995,11 @@ impl VirtioGpu {
             }
         }
 
-        ProcessDisplayResult::Success
+        if displays_updated {
+            ProcessDisplayResult::DisplaysUpdated
+        } else {
+            ProcessDisplayResult::Success
+        }
     }
 
     /// Sets the given resource id as the source of scanout to the display.
@@ -1473,7 +1548,11 @@ impl VirtioGpu {
             Some(scanout) => {
                 // Primary scanouts should always have display params.
                 let params = scanout.display_params.as_ref().unwrap();
-                DisplayInfo::new(params)
+                if scanout.scale120 > 0 {
+                    DisplayInfo::new_for_scale(params, scanout.scale120)
+                } else {
+                    DisplayInfo::new(params)
+                }
             }
             None => DisplayInfo::new(&Default::default()),
         };
