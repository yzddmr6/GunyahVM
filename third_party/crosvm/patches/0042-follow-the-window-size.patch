+bool dwl_surface_resize(struct dwl_surface *self, int shm_fd, size_t shm_size, size_t buffer_size,
+			uint32_t width, uint32_t height, uint32_t stride)
+{
+	struct wl_buffer *buffers[MAX_BUFFER_COUNT] = {0};
+	struct wl_shm_pool *pool;
+	size_t i;
+
+	if (buffer_size == 0 || shm_size / buffer_size != self->buffer_count)
+		return false;
+	pool = wl_shm_create_pool(self->context->ifaces.shm, shm_fd, shm_size);
+	if (!pool)
+		return false;
+	for (i = 0; i < self->buffer_count; i++) {
+		buffers[i] = wl_shm_pool_create_buffer(pool, buffer_size * i, width, height, stride,
+						       self->shm_format);
+		if (!buffers[i])
+			break;
+	}
+	wl_shm_pool_destroy(pool);
+	if (i < self->buffer_count) {
+		while (i-- > 0)
+			wl_buffer_destroy(buffers[i]);
+		return false;
+	}
+	for (i = 0; i < self->buffer_count; i++) {
+		wl_buffer_destroy(self->buffers[i]);
+		self->buffers[i] = buffers[i];
+		wl_buffer_add_listener(self->buffers[i], &surface_buffer_listener, self);
+	}
