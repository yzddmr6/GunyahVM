             need_to_create = true;
@@ -331,9 +347,21 @@ impl VirtioGpuScanout {
             if !(self.width == new_width && self.height == new_height) {
                 self.width = new_width;
                 self.height = new_height;
-                need_to_create = true;
+                need_to_resize = true;
