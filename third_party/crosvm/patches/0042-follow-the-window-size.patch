+bool dwl_surface_take_size(struct dwl_surface *self, uint32_t *width, uint32_t *height,
+			   uint32_t *scale120)
+{
+	double scale;
+
+	if (!self->size_pending || self->want_width <= 0 || self->want_height <= 0)
+		return false;
+	/* the compositor sends the exact scale right after the object is created; until then the
+	 * output scale is only an approximation */
