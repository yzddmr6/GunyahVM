@@ -166,6 +166,17 @@ impl DisplayInfo {
         }
     }
 
+    /// GunyahVM: the same timing with a physical size for which GNOME's automatic scale picks
+    /// `scale120 / 120` (the host window's scale) at this resolution.
+    pub fn new_for_scale(params: &GpuDisplayParameters, scale120: u32) -> Self {
+        let mut info = Self::new(params);
+        let (width_cm, height_cm) =
+            size_for_scale(info.width(), info.height(), scale120 as f64 / 120.0);
+        info.width_millimeters = width_cm * 10;
+        info.height_millimeters = height_cm * 10;
+        info
+    }
+
     pub fn width(&self) -> u32 {
         self.resolution.width
     }
@@ -183,6 +194,45 @@ impl DisplayInfo {
     }
 }
 
+/// GNOME's automatic scale for a mode (mutter meta-monitor.c calculate_scale, before it snaps to a
+/// supported scale): diagonal pixels per inch over a target of 135 DPI below 20 inches and 110 DPI
+/// from 20 inches up. The guest kernel reads the size as the EDID's whole centimetres.
+fn gnome_scale(width: u32, height: u32, width_cm: u16, height_cm: u16) -> f64 {
+    let diagonal_inches = ((width_cm as f64 * 10.0).powi(2) + (height_cm as f64 * 10.0).powi(2))
+        .sqrt()
+        / MILLIMETERS_PER_INCH as f64;
+    let target_dpi = if diagonal_inches < 20.0 { 135.0 } else { 110.0 };
+    ((width as f64).powi(2) + (height as f64).powi(2)).sqrt() / diagonal_inches / target_dpi
+}
+
+/// Whole centimetres for which `gnome_scale` is closest to `scale`. Mutter takes 16x9 and 16x10 cm
+/// for an aspect ratio rather than a size and then uses scale 1, so those are skipped.
+fn size_for_scale(width: u32, height: u32, scale: f64) -> (u16, u16) {
+    let (w, h) = (width as f64, height as f64);
+    let diagonal_px = (w * w + h * h).sqrt();
+    let mut best = (1, 1);
+    let mut best_error = f64::MAX;
+    for target_dpi in [135.0, 110.0] {
+        let diagonal_cm = diagonal_px / (target_dpi * scale) * 2.54;
+        let (wc, hc) = (w / diagonal_px * diagonal_cm, h / diagonal_px * diagonal_cm);
+        for dw in -1..=2 {
+            for dh in -1..=2 {
+                let cw = (wc.floor() as i32 + dw).clamp(1, 255) as u16;
+                let ch = (hc.floor() as i32 + dh).clamp(1, 255) as u16;
+                if cw == 16 && (ch == 9 || ch == 10) {
+                    continue;
+                }
+                let error = (gnome_scale(width, height, cw, ch) - scale).abs();
+                if error < best_error {
+                    best = (cw, ch);
+                    best_error = error;
+                }
+            }
+        }
+    }
+    best
+}
+
 fn populate_display_name(edid_block: &mut [u8]) {
     // Display Product Name String Descriptor Tag
     edid_block[0..5].clone_from_slice(&[0x00, 0x00, 0x00, 0xFC, 0x00]);
@@ -218,9 +268,18 @@ fn populate_detailed_timing_descriptor(edid_block: &mut [u8], info: &DisplayInfo
     //
     let htotal = info.width() + (info.horizontal_blanking as u32);
     let vtotal = info.height() + (info.vertical_blanking as u32);
-    let mut clock: u16 = ((info.refresh_rate * htotal * vtotal) / 10000) as u16;
+    // GunyahVM: this field holds 16 bits of 10 kHz (655.35 MHz). A larger mode (a window-sized
+    // 3392x2400 at 120 Hz needs about 1160 MHz) used to wrap to a slow, wrong rate; it now gets the
+    // highest refresh rate that fits here, and the DisplayID block keeps the requested one.
+    let pixels = htotal as u64 * vtotal as u64;
+    let mut refresh_rate = info.refresh_rate as u64;
+    if refresh_rate * pixels / 10000 > 65530 {
+        refresh_rate = 65530 * 10000 / pixels;
+    }
+    let mut clock = (refresh_rate * pixels / 10000) as u32;
     // Round to nearest 10khz.
     clock = ((clock + 5) / 10) * 10;
+    let clock = clock.min(u16::MAX as u32) as u16;
     edid_block[0..2].copy_from_slice(&clock.to_le_bytes());
 
     let width_lsb: u8 = (info.width() & 0b11111111) as u8; // least sig 8 bits
@@ -497,3 +556,43 @@ fn calculate_checksum(block: &mut [u8], length: usize) {
 
     block[length] = checksum;
 }
+
+#[cfg(test)]
+mod gvm_tests {
+    use super::*;
+
+    #[test]
+    fn size_for_scale_gives_gnome_the_window_scale() {
+        for &(w, h, scale) in &[
+            (2560, 1600, 2.0),
+            (3392, 2400, 2.0),
+            (2132, 1300, 2.0),
+            (1280, 800, 1.0),
+            (3840, 2160, 1.0),
+            (2400, 1600, 8.0 / 3.0),
+            (1750, 1000, 1.75),
+        ] {
+            let (cw, ch) = size_for_scale(w, h, scale);
+            let got = gnome_scale(w, h, cw, ch);
+            assert!((got - scale).abs() < 0.04, "{w}x{h} at {scale}: {cw}x{ch} cm gives {got}");
+        }
+    }
+
+    #[test]
+    fn large_modes_keep_a_valid_base_timing() {
+        let params = GpuDisplayParameters::new(
+            vm_control::gpu::DisplayMode::Windowed(3392, 2400),
+            false,
+            120,
+            0,
+            0,
+        );
+        let info = DisplayInfo::new(&params);
+        let mut block = [0u8; 18];
+        populate_detailed_timing_descriptor(&mut block, &info);
+        let clock = u16::from_le_bytes([block[0], block[1]]) as u64 * 10000;
+        let pixels = (3392 + 560) as u64 * (2400 + 50) as u64;
+        let refresh = clock / pixels;
+        assert!((50..120).contains(&refresh), "base timing at {refresh} Hz");
+    }
+}
