+// found in the LICENSE file.
+
+//! rutabaga_utils: Utility enums, structs, and implementations needed by the rest of the crate.
+
+use std::fmt;
+use std::os::raw::c_char;
+use std::os::raw::c_void;
+use std::path::PathBuf;
