+impl Drop for VirglRendererContext {
+    fn drop(&mut self) {
+        // SAFETY:
+        // The context is safe to destroy because nothing else can be referencing it.
+        unsafe {
+            virgl_renderer_context_destroy(self.ctx_id);
+        }
+    }
+}
