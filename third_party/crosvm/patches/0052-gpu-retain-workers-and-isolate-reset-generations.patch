+#[cfg(test)]
+mod tests {
+    use crate::*;
+    use std::fs;
+
+    fn new_2d() -> Rutabaga {
+        RutabagaBuilder::new(0, RutabagaHandler::new(|_| {}))
+            .set_default_component(RutabagaComponentType::Rutabaga2D)
+            .build()
+            .unwrap()
+    }
+
+    #[test]
+    fn reset_releases_each_resource_in_its_own_component() {
+        use super::*;
+        use std::sync::{Arc, Mutex};
+        struct Recorder(Arc<Mutex<Vec<(u32, &'static str)>>>);
+        impl RutabagaComponent for Recorder {
+            fn detach_backing(&self, id: u32) {
+                self.0.lock().unwrap().push((id, "detach"));
+            }
+            fn unref_resource(&self, id: u32) {
+                self.0.lock().unwrap().push((id, "unref"));
+            }
+        }
+        let mut r = new_2d();
+        let first = Arc::new(Mutex::new(Vec::new()));
+        let second = Arc::new(Mutex::new(Vec::new()));
+        let params = ResourceCreate3D {
+            target: 0,
+            format: 0,
+            bind: 0,
+            width: 1,
+            height: 1,
+            depth: 1,
+            array_size: 1,
+            last_level: 0,
+            nr_samples: 0,
+            flags: 0,
+        };
+        for (id, kind, log) in [
+            (1, RutabagaComponentType::Rutabaga2D, first.clone()),
+            (2, RutabagaComponentType::VirglRenderer, second.clone()),
+        ] {
+            let component = Recorder(log);
+            let mut resource = component.create_3d(id, params).unwrap();
+            resource.component_mask = 1 << kind as u8;
+            r.resources.insert(id, resource);
+            r.components.insert(kind, Box::new(component));
+        }
+        r.reset().unwrap();
+        assert_eq!(*first.lock().unwrap(), vec![(1, "detach"), (1, "unref")]);
+        assert_eq!(*second.lock().unwrap(), vec![(2, "detach"), (2, "unref")]);
+        assert!(r.resources.is_empty());
+        r.resource_create_3d(1, params).unwrap();
+    }
+
+    #[test]
+    fn snapshot_restore_2d_no_resources() {
+        let mut snapshot_dir = std::env::temp_dir();
+        snapshot_dir.push("rutabaga_snapshot");
+
+        fs::create_dir(&snapshot_dir).unwrap();
+
+        let rutabaga1 = new_2d();
+        rutabaga1.snapshot(snapshot_dir.as_path()).unwrap();
+
+        let mut rutabaga1 = new_2d();
+        rutabaga1.restore(snapshot_dir.as_path()).unwrap();
+
+        fs::remove_dir_all(&snapshot_dir).unwrap();
+    }
+
+    #[test]
+    fn snapshot_restore_2d_one_resource() {
+        let mut snapshot_dir = std::env::temp_dir();
+        snapshot_dir.push("rutabaga_snapshot2");
+        fs::create_dir(&snapshot_dir).unwrap();
+
+        let resource_id = 123;
+        let resource_create_3d = ResourceCreate3D {
+            target: RUTABAGA_PIPE_TEXTURE_2D,
+            format: 1,
+            bind: RUTABAGA_PIPE_BIND_RENDER_TARGET,
+            width: 100,
+            height: 200,
+            depth: 1,
+            array_size: 1,
+            last_level: 0,
+            nr_samples: 0,
+            flags: 0,
+        };
+
+        let mut rutabaga1 = new_2d();
+        rutabaga1
+            .resource_create_3d(resource_id, resource_create_3d)
+            .unwrap();
+        rutabaga1
+            .attach_backing(
+                resource_id,
+                vec![RutabagaIovec {
+                    base: std::ptr::null_mut(),
+                    len: 456,
+                }],
+            )
+            .unwrap();
+        rutabaga1.snapshot(snapshot_dir.as_path()).unwrap();
+
+        let mut rutabaga2 = new_2d();
+        rutabaga2.restore(snapshot_dir.as_path()).unwrap();
+
+        assert_eq!(rutabaga2.resources.len(), 1);
+        let rutabaga_resource = rutabaga2.resources.get(&resource_id).unwrap();
+        assert_eq!(rutabaga_resource.resource_id, resource_id);
+        assert_eq!(
+            rutabaga_resource.info_2d.as_ref().unwrap().width,
+            resource_create_3d.width
+        );
+        assert_eq!(
+            rutabaga_resource.info_2d.as_ref().unwrap().height,
+            resource_create_3d.height
+        );
+        // NOTE: We attached an backing iovec, but it should be gone post-restore.
+        assert!(rutabaga_resource.backing_iovecs.is_none());
+
+        fs::remove_dir_all(&snapshot_dir).unwrap();
+    }
+}
