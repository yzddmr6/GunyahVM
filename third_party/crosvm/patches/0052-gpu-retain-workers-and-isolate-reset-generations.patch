+    #[cfg(target_os = "linux")]
+    fn reset_keeps_the_worker_available_for_reactivation() {
+        use crate::virtio::QueueConfig;
+        let (exit, _events) = Tube::directional_pair().unwrap();
+        let (_control_host, control) = Tube::pair().unwrap();
+        let mut params = GpuParameters::default();
+        params.mode = GpuMode::Mode2D;
+        let mut gpu = Gpu::new(
+            exit,
+            control,
+            Vec::new(),
+            vec![DisplayBackend::Stub],
+            &params,
+            None,
+            Vec::new(),
+            0,
+            &BTreeMap::new(),
+            None,
+        );
+        gpu.on_device_sandboxed();
+        let mem = GuestMemory::new(&[(GuestAddress(0), 0x20000)]).unwrap();
+        for _ in 0..2 {
+            let irq = Interrupt::new(
+                crate::IrqLevelEvent::new().unwrap(),
+                None,
+                0,
+                #[cfg(target_arch = "x86_64")]
+                None,
+            );
+            let notified = irq.get_interrupt_evt().try_clone().unwrap();
+            let kick = Event::new().unwrap();
+            let mut queues = BTreeMap::new();
+            for i in 0..2 {
+                let mut q = QueueConfig::new(256, 0);
+                q.set_size(8);
+                let base = 0x1000 + i as u64 * 0x3000;
+                q.set_desc_table(GuestAddress(base));
+                q.set_avail_ring(GuestAddress(base + 0x1000));
+                q.set_used_ring(GuestAddress(base + 0x2000));
+                q.set_ready(true);
+                queues.insert(
+                    i,
+                    q.activate(
+                        &mem,
+                        if i == 0 {
+                            kick.try_clone().unwrap()
