+
+    /// A classic (virgl) resource: export its host texture with the layout the host EGL reports.
+    /// The texture's pitch follows the GPU's alignment, not width * 4, and its fourcc and modifier
+    /// are those of the texture's storage (rutabaga records them at creation).
+    fn import_texture_to_display(
+        display: &Rc<RefCell<GpuDisplay>>,
+        surface_id: u32,
+        resource: &mut VirtioGpuResource,
+        rutabaga: &mut Rutabaga,
+    ) -> Option<u32> {
+        let info = rutabaga.resource3d_info(resource.resource_id).ok()?;
+        rutabaga.force_ctx_0();
+        let texture = match super::gvm_export::texture(resource.resource_id) {
+            Ok(texture) => texture,
+            Err(e) => {
+                super::gvm_scanout::note("EXPORT", resource.resource_id, &e);
+                return None;
+            }
+        };
+        let fourcc = if texture.opaque {
+            super::gvm_export::opaque_fourcc(info.drm_fourcc)
+        } else {
+            info.drm_fourcc
+        };
+        super::gvm_scanout::note(
+            "IMPORT",
+            resource.resource_id,
+            &format!(
+                "{}x{} fourcc={:#010x} (exported {:#010x}) modifier={:#x} stride={} offset={}",
+                resource.width, resource.height, fourcc, info.drm_fourcc, info.modifier,
+                texture.stride, texture.offset
+            ),
+        );
+        let import_id = display
+            .borrow_mut()
+            .import_resource(
+                surface_id,
+                DisplayExternalResourceImport::Dmabuf {
+                    descriptor: &texture.dmabuf,
+                    offset: texture.offset,
+                    stride: texture.stride,
+                    modifiers: info.modifier,
+                    width: resource.width,
+                    height: resource.height,
+                    fourcc,
+                },
+            )
+            .ok()?;
+        resource.display_import.insert(surface_id, import_id);
+        resource.display_import_refused = false;
+        Some(import_id)
+    }
 }
 
