+// Copyright 2026 yzddMr6. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! GunyahVM: the dmabuf and real layout of a classic (virgl) resource's host texture.
+//!
+//! rutabaga exports these textures with `virgl_renderer_get_fd_for_texture`, which drops the
+//! stride and offset that the host EGL reports, and records `width * 4` as the stride. A linear
+//! Adreno texture's pitch is aligned to 64 pixels, so a scanout whose width is not a multiple of 64
+//! (a window-sized guest display) would be sheared when imported with that stride.
+//! `virgl_renderer_get_fd_for_texture2` returns the stride and offset of the exported image.
+
+use base::SafeDescriptor;
+
+pub struct Texture {
+    pub dmabuf: SafeDescriptor,
+    pub stride: u32,
+    pub offset: u32,
+    /// The guest's format has no alpha (an XRGB scanout).
+    pub opaque: bool,
+}
+
+/// virgl formats whose fourth channel the guest ignores: B8G8R8X8, X8R8G8B8, X8B8G8R8, R8G8B8X8
+/// (UNORM and SRGB), B10G10R10X2 and R10G10B10X2.
+#[cfg(feature = "virgl_renderer")]
+const OPAQUE_VIRGL_FORMATS: [u32; 10] = [2, 4, 68, 99, 101, 103, 134, 230, 233, 308];
+
+const fn fourcc(code: &[u8; 4]) -> u32 {
+    u32::from_le_bytes(*code)
+}
+
+/// The fourcc that shows a texture the way the guest sees it. A GLES host stores the guest's
+/// B8G8R8X8 scanout as an RGBA8 texture and the host EGL exports it as ABGR8888: the compositor
+/// would then blend with whatever the fourth byte holds (often 0, an invisible, black window).
+pub fn opaque_fourcc(code: u32) -> u32 {
+    match code {
+        c if c == fourcc(b"AR24") => fourcc(b"XR24"),
+        c if c == fourcc(b"AB24") => fourcc(b"XB24"),
+        c if c == fourcc(b"RA24") => fourcc(b"RX24"),
+        c if c == fourcc(b"BA24") => fourcc(b"BX24"),
+        c if c == fourcc(b"AR30") => fourcc(b"XR30"),
+        c if c == fourcc(b"AB30") => fourcc(b"XB30"),
+        c => c,
+    }
+}
+
+/// virglrenderer's `VIRGL_RESOURCE_Y_0_TOP`: the texture is stored bottom row first.
+#[cfg(feature = "virgl_renderer")]
+const VIRGL_RESOURCE_Y_0_TOP: u32 = 1;
+
+#[cfg(feature = "virgl_renderer")]
+mod ffi {
+    /// `struct virgl_renderer_resource_info` (virglrenderer.h).
+    #[repr(C)]
+    #[derive(Default)]
+    pub struct ResourceInfo {
+        pub handle: u32,
+        pub virgl_format: u32,
+        pub width: u32,
+        pub height: u32,
+        pub depth: u32,
+        pub flags: u32,
+        pub tex_id: u32,
+        pub stride: u32,
+        pub drm_fourcc: i32,
+        pub fd: i32,
+    }
+
+    extern "C" {
+        pub fn virgl_renderer_resource_get_info(res_handle: i32, info: *mut ResourceInfo) -> i32;
+        pub fn virgl_renderer_get_fd_for_texture2(
+            tex_id: u32,
+            fd: *mut i32,
+            stride: *mut i32,
+            offset: *mut i32,
+        ) -> i32;
+    }
+}
+
+/// Exports the host texture of a classic virgl resource. The caller makes context 0 current.
+#[cfg(feature = "virgl_renderer")]
+pub fn texture(resource_id: u32) -> Result<Texture, String> {
+    use base::FromRawDescriptor;
+
+    let mut info = ffi::ResourceInfo::default();
+    // SAFETY: virglrenderer is initialized while virtio-gpu resources exist; `info` is a valid
+    // pointer to a struct of the declared layout, and the call does not keep it.
+    let ret = unsafe { ffi::virgl_renderer_resource_get_info(resource_id as i32, &mut info) };
+    if ret != 0 {
+        return Err(format!("resource info: {}", ret));
+    }
+    if info.tex_id == 0 {
+        return Err("no host texture".to_string());
+    }
+    if info.flags & VIRGL_RESOURCE_Y_0_TOP != 0 {
+        // Stored bottom row first: transfer_read turns it over, an import would not.
+        return Err("texture is stored bottom row first".to_string());
+    }
+    let (mut fd, mut stride, mut offset) = (-1i32, 0i32, 0i32);
+    // SAFETY: the texture belongs to the context-0 share group; the outputs are valid pointers and
+    // the returned fd is owned by the caller.
+    let ret = unsafe {
+        ffi::virgl_renderer_get_fd_for_texture2(info.tex_id, &mut fd, &mut stride, &mut offset)
+    };
+    if ret != 0 || fd < 0 {
+        return Err(format!("texture export: {}", ret));
+    }
+    // SAFETY: fd was just returned by a successful export and nothing else owns it.
+    let dmabuf = unsafe { SafeDescriptor::from_raw_descriptor(fd) };
+    if stride <= 0 || offset < 0 {
+        return Err(format!("texture layout: stride {} offset {}", stride, offset));
+    }
+    Ok(Texture {
+        dmabuf,
+        stride: stride as u32,
+        offset: offset as u32,
+        opaque: OPAQUE_VIRGL_FORMATS.contains(&info.virgl_format),
+    })
+}
+
+#[cfg(not(feature = "virgl_renderer"))]
+pub fn texture(_resource_id: u32) -> Result<Texture, String> {
+    Err("built without virglrenderer".to_string())
+}
