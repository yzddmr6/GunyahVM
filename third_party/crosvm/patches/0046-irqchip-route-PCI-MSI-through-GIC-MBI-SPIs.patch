-    fn service_irq_event(&self, _event_index: IrqEventIndex) -> Result<()> {
-        unreachable!();
+    fn service_irq_event(&self, event_index: IrqEventIndex) -> Result<()> {
+        let mbi = self.mbi.lock();
+        let Some(mbi) = mbi.as_ref() else {
+            return Ok(());
+        };
+        if let Some(Some((_, event, target))) = mbi.vectors.get(event_index) {
+            event.wait()?;
+            if let Some(spi) = target {
+                mbi.spis[*spi].signal()?;
+            }
+        }
+        Ok(())
     }
 
     /// Broadcast an end of interrupt.
@@ -171,4 +245,36 @@ impl IrqChipAArch64 for GunyahIrqChip {
     fn finalize(&self) -> Result<()> {
         Ok(())
     }
+
+    fn enable_mbi(&self, base_spi: u32, count: u32, doorbell: u64) -> Result<Vec<Event>> {
+        let mut spis = Vec::new();
+        for spi in base_spi..base_spi + count {
+            let event = Event::new()?;
+            self.vm.register_irqfd(spi, &event, false)?;
+            spis.push(event);
+        }
+        let frame = spis
+            .iter()
+            .map(Event::try_clone)
+            .collect::<Result<Vec<_>>>()?;
+        *self.mbi.lock() = Some(Mbi {
+            base_spi,
+            doorbell,
+            spis,
+            vectors: Vec::new(),
+        });
+        Ok(frame)
+    }
+
+    fn mbi_route_event(&self, gsi: u32) -> Option<Event> {
+        let mbi = self.mbi.lock();
+        let mbi = mbi.as_ref()?;
+        let spi = mbi
+            .vectors
+            .iter()
+            .flatten()
+            .find(|(g, _, _)| *g == gsi)?
+            .2?;
+        mbi.spis[spi].try_clone().ok()
+    }
 }
