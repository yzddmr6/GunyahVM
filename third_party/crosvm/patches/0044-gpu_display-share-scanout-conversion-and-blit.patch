     ] {
         build.file(compile_protocol(protocol, &out_dir));
     }
+    let mut blit_libraries = Vec::new();
+    if env::var_os("CARGO_FEATURE_WAYLAND_GPU_BLIT").is_some() {
+        for lib in ["egl", "glesv2", "gbm", "libdrm"] {
+            let library = pkg_config::Config::new()
+                .cargo_metadata(false)
+                .probe(lib)
+                .expect(lib);
+            for path in &library.include_paths {
+                build.include(path);
