+/* Read release events on the display worker, without a blocking roundtrip.
+ * Every prepare_read must be paired with read_events or cancel_read. */
+static bool dwl_surface_wait_gpu_buffer(struct dwl_surface *self, struct dwl_gpu_buffer **buffer)
+{
+	struct wl_display *display = self->context->display;
+	int64_t deadline = monotonic_ns() + GPU_BUFFER_WAIT_NS;
+	for (;;) {
+		if (wl_display_dispatch_pending(display) < 0)
+			return false;
+		*buffer = dwl_surface_idle_gpu_buffer(self);
+		int64_t remaining = deadline - monotonic_ns();
+		if (*buffer || remaining <= 0)
+			return true;
+
+		if (wl_display_prepare_read(display) < 0) {
+			if (errno == EAGAIN)
+				continue;
+			return false;
+		}
+		struct pollfd fd = { .fd = wl_display_get_fd(display), .events = POLLIN };
+		if (wl_display_flush(display) < 0) {
+			if (errno != EAGAIN) {
+				wl_display_cancel_read(display);
+				return false;
+			}
+			fd.events |= POLLOUT;
+		}
+		int result = poll(&fd, 1, (remaining + 999999) / 1000000);
+		int poll_error = errno;
+		if (result > 0 && (fd.revents & POLLIN)) {
+			if (wl_display_read_events(display) < 0)
+				return false;
+		} else {
+			wl_display_cancel_read(display);
+			if ((result < 0 && poll_error != EINTR) ||
+			    (fd.revents & (POLLERR | POLLHUP | POLLNVAL)))
+				return false;
+		}
+	}
+}
