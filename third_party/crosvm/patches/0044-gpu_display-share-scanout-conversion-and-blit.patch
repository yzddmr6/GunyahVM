+#ifdef DWL_GPU_BLIT
+static int64_t monotonic_ns(void)
+{
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	return (int64_t)now.tv_sec * INT64_C(1000000000) + now.tv_nsec;
+}
+
+static struct dwl_gpu_buffer *dwl_surface_idle_gpu_buffer(struct dwl_surface *self)
+{
+	for (size_t i = 0; i < self->gpu_buffer_count; i++) {
+		struct dwl_gpu_buffer *slot = &self->gpu_buffers[i];
+		if (!slot->export->in_use)
+			return slot;
+	}
+	return NULL;
+}
