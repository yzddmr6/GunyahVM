+static const char *dwl_surface_blit(struct dwl_surface *self, struct dwl_dmabuf *source)
+{
+	if (self->width > source->width || self->height > source->height)
+		return "guest DMA-BUF is smaller than the scanout";
+
+	struct dwl_context *ctx = self->context;
+	struct dwl_gpu_buffer *buffer = dwl_surface_idle_gpu_buffer(self);
+	if (!buffer && self->gpu_buffer_count >= GPU_BUFFER_INITIAL_COUNT &&
+	    !dwl_surface_wait_gpu_buffer(self, &buffer))
+		return "receiving Wayland output buffer releases";
+
+	if (!buffer) {
+		if (self->gpu_buffer_count == GPU_BUFFER_MAX_COUNT) {
+			int64_t now = monotonic_ns();
+			if (now >= self->gpu_next_drop_log) {
+				self->gpu_next_drop_log = now + GPU_BUFFER_DROP_LOG_NS;
+				fprintf(stderr, "Wayland GPU scanout: all %zu outputs busy after 16 ms, dropping frame\n",
+					self->gpu_buffer_count);
+			}
+			return NULL;
+		}
+		buffer = &self->gpu_buffers[self->gpu_buffer_count];
+	}
+
+	const char *error;
+	if (!buffer->export) {
+		struct dwl_blit_dmabuf desc = {
+			.width = self->width, .height = self->height,
+			.fourcc = ctx->xrgb_linear ? DRM_FORMAT_XRGB8888 : DRM_FORMAT_ARGB8888,
+		};
+		struct dwl_blit_image *image = dwl_blitter_target(ctx->blitter, &desc, &error);
+		if (!image)
+			return error;
+		buffer->export = dwl_create_buffer(ctx, desc.fd, desc.offset, desc.stride,
+						  desc.modifier, desc.width, desc.height, desc.fourcc);
+		close(desc.fd);
+		if (!buffer->export) {
+			dwl_blitter_free_image(ctx->blitter, image);
+			return "Wayland refused the linear GBM output";
+		}
+		buffer->image = image;
+		self->gpu_buffer_count++;
+		if (self->gpu_buffer_count > GPU_BUFFER_INITIAL_COUNT)
+			fprintf(stderr, "Wayland GPU scanout: grew output pool to %zu\n", self->gpu_buffer_count);
+	}
+
+	if (!dwl_blitter_draw(ctx->blitter, source->image, buffer->image, &error))
+		return error;
+	dwl_surface_attach_dmabuf(self, buffer->export);
+	if (!ctx->blit_reported) {
+		ctx->blit_reported = true;
+		fprintf(stderr, "Wayland GPU scanout active: fenced GLES blit to linear 8-bit DMA-BUF\n");
+	}
+	return NULL;
+}
+#endif
+
+const char *dwl_surface_flip_to(struct dwl_surface *self, uint32_t import_id)
+{
+	// Surface and dmabuf have to exist in same context.
+	struct dwl_dmabuf *dmabuf = dwl_context_get_dmabuf(self->context, import_id);
+	if (!dmabuf)
+		return NULL;
+#ifdef DWL_GPU_BLIT
+	if (dmabuf->image)
+		return dwl_surface_blit(self, dmabuf);
+#endif
+	if (self->width == dmabuf->width && self->height == dmabuf->height)
+		dwl_surface_attach_dmabuf(self, dmabuf);
+	return NULL;
 }
 
 bool dwl_surface_close_requested(const struct dwl_surface *self)
diff --git a/gpu_display/src/display_wl_blit.c b/gpu_display/src/display_wl_blit.c
new file mode 100644
index 0000000000000000000000000000000000000000..df336d07cdd955e59fd869c9757af53785216f0e
--- /dev/null
+++ b/gpu_display/src/display_wl_blit.c
@@ -0,0 +1,426 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#include "display_wl_blit.h"
+
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES3/gl3.h>
+#include <GLES2/gl2ext.h>
+#include <drm_fourcc.h>
+#include <fcntl.h>
+#include <gbm.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+struct dwl_blitter {
+	int fd;
+	struct gbm_device *gbm;
+	EGLDisplay display;
+	EGLContext context;
+	bool initialized;
+	bool modifiers;
+	PFNGLEGLIMAGETARGETTEXTURE2DOESPROC bind_image;
+	GLuint program;
+	GLint half_float;
+};
+
+struct dwl_blit_image {
+	struct gbm_bo *bo;
+	GLuint texture;
+	GLuint framebuffer;
+	uint32_t width, height, fourcc;
+};
+
+struct egl_binding {
+	EGLenum api;
+	EGLDisplay display;
+	EGLContext context;
+	EGLSurface draw, read;
+};
+
+static struct egl_binding current_binding(void)
+{
+	return (struct egl_binding) {
+		eglQueryAPI(), eglGetCurrentDisplay(), eglGetCurrentContext(),
+		eglGetCurrentSurface(EGL_DRAW), eglGetCurrentSurface(EGL_READ),
+	};
+}
+
+/* virgl may already own a context on the virtio GPU worker. */
+static bool bind_blitter(const struct dwl_blitter *blitter)
+{
+	return eglBindAPI(EGL_OPENGL_ES_API) &&
+	       eglMakeCurrent(blitter->display, EGL_NO_SURFACE, EGL_NO_SURFACE, blitter->context);
+}
+
+static bool restore_binding(const struct dwl_blitter *blitter, struct egl_binding binding)
+{
+	if (eglGetCurrentContext() == blitter->context &&
+	    !eglMakeCurrent(blitter->display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT))
+		return false;
+	return eglBindAPI(binding.api) &&
+	       (binding.context == EGL_NO_CONTEXT ||
+		eglMakeCurrent(binding.display, binding.draw, binding.read, binding.context));
+}
+
+static bool has_extension(const char *extensions, const char *name)
+{
+	if (!extensions)
+		return false;
+	size_t length = strlen(name);
+	for (const char *at = extensions; (at = strstr(at, name)); at += length) {
+		if ((at == extensions || at[-1] == ' ') && (at[length] == ' ' || at[length] == '\0'))
+			return true;
+	}
+	return false;
+}
+
+static const char vertex_shader[] =
+	"#version 300 es\n"
+	"void main() {\n"
+	"  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);\n"
+	"  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+	"}\n";
+
+static const char fragment_shader[] =
+	"#version 300 es\n"
+	"precision highp float;\n"
+	"precision highp int;\n"
+	"uniform highp sampler2D source_image;\n"
+	"uniform bool half_float;\n"
+	"out vec4 output_color;\n"
+	// Match the m10 lookup exactly, including the index midpoint and its NaN policy.
+	"float half_to_unorm(float channel) {\n"
+	"  uint bits = (packHalf2x16(vec2(channel, 0.0)) & 0xfffcu) | 2u;\n"
+	"  if (isnan(channel) || (bits & 0x8000u) != 0u || (bits & 0x7c00u) == 0x7c00u)\n"
+	"    return 0.0;\n"
+	"  float value = unpackHalf2x16(bits).x;\n"
+	"  return floor(clamp(value, 0.0, 1.0) * 255.0 + 0.5) / 255.0;\n"
+	"}\n"
+	"void main() {\n"
+	"  vec3 rgb = texelFetch(source_image, ivec2(gl_FragCoord.xy), 0).rgb;\n"
+	"  if (half_float)\n"
+	"    rgb = vec3(half_to_unorm(rgb.r), half_to_unorm(rgb.g), half_to_unorm(rgb.b));\n"
+	"  output_color = vec4(rgb, 1.0);\n"
+	"}\n";
+
+static GLuint compile_shader(GLenum type, const char *source)
+{
+	GLuint shader = glCreateShader(type);
+	glShaderSource(shader, 1, &source, NULL);
+	glCompileShader(shader);
+	GLint compiled = GL_FALSE;
+	glGetShaderiv(shader, GL_COMPILE_STATUS, &compiled);
+	if (compiled)
+		return shader;
+	glDeleteShader(shader);
+	return 0;
+}
+
+static bool init_program(struct dwl_blitter *blitter)
+{
+	GLuint vertex = compile_shader(GL_VERTEX_SHADER, vertex_shader);
+	GLuint fragment = compile_shader(GL_FRAGMENT_SHADER, fragment_shader);
+	GLint linked = GL_FALSE;
+	if (vertex && fragment) {
+		blitter->program = glCreateProgram();
+		glAttachShader(blitter->program, vertex);
+		glAttachShader(blitter->program, fragment);
+		glLinkProgram(blitter->program);
+		glGetProgramiv(blitter->program, GL_LINK_STATUS, &linked);
+	}
+	glDeleteShader(vertex);
+	glDeleteShader(fragment);
+	if (linked) {
+		glUseProgram(blitter->program);
+		blitter->half_float = glGetUniformLocation(blitter->program, "half_float");
+		glUniform1i(glGetUniformLocation(blitter->program, "source_image"), 0);
+		glDisable(GL_DITHER);
+	}
+	return linked && glGetError() == GL_NO_ERROR;
+}
+
+static EGLContext create_blit_context(EGLDisplay display, EGLConfig config, const char *extensions)
+{
+	const EGLint default_attrs[] = { EGL_CONTEXT_CLIENT_VERSION, 3, EGL_NONE };
+	const char *override = getenv("CROSVM_GVM_BLIT_PRIORITY");
+	bool normal = override && strcmp(override, "normal") == 0;
+	const char *mode = normal ? "normal requested" : "EGL_IMG_context_priority unavailable";
+	EGLContext context = EGL_NO_CONTEXT;
+	EGLint actual = 0;
+
+	if (!normal && has_extension(extensions, "EGL_IMG_context_priority")) {
+		const EGLint high_attrs[] = {
+			EGL_CONTEXT_CLIENT_VERSION, 3,
+			EGL_CONTEXT_PRIORITY_LEVEL_IMG, EGL_CONTEXT_PRIORITY_HIGH_IMG,
+			EGL_NONE,
+		};
+		context = eglCreateContext(display, config, EGL_NO_CONTEXT, high_attrs);
+		if (context != EGL_NO_CONTEXT &&
+		    eglQueryContext(display, context, EGL_CONTEXT_PRIORITY_LEVEL_IMG, &actual) &&
+		    actual == EGL_CONTEXT_PRIORITY_HIGH_IMG) {
+			mode = "high granted";
+		} else {
+			mode = "high unavailable, using default";
+			if (context != EGL_NO_CONTEXT)
+				eglDestroyContext(display, context);
+			context = EGL_NO_CONTEXT;
+		}
+	}
+
+	if (context == EGL_NO_CONTEXT) {
+		context = eglCreateContext(display, config, EGL_NO_CONTEXT, default_attrs);
+		actual = 0;
+		if (context != EGL_NO_CONTEXT && has_extension(extensions, "EGL_IMG_context_priority"))
+			eglQueryContext(display, context, EGL_CONTEXT_PRIORITY_LEVEL_IMG, &actual);
+	}
+	static bool reported = false;
+	if (context != EGL_NO_CONTEXT && !reported) {
+		reported = true;
+		fprintf(stderr, "Wayland GPU scanout: EGL context priority %s (actual=%#x)\n",
+			mode, actual);
+	}
+	return context;
+}
+
+struct dwl_blitter *dwl_blitter_new(const char *node, const char **error)
+{
+	struct dwl_blitter *blitter = calloc(1, sizeof(*blitter));
+	*error = "allocating the EGL blitter";
+	if (!blitter)
+		return NULL;
+
+	struct egl_binding binding = current_binding();
+	*error = "opening the render node for GBM";
+	blitter->fd = open(node, O_RDWR | O_CLOEXEC);
+	if (blitter->fd < 0)
+		goto fail;
+	blitter->gbm = gbm_create_device(blitter->fd);
+	if (!blitter->gbm)
+		goto fail;
+
+	*error = "initializing an EGL GBM display";
+	blitter->display = eglGetPlatformDisplay(EGL_PLATFORM_GBM_KHR, blitter->gbm, NULL);
+	if (blitter->display == EGL_NO_DISPLAY || !eglInitialize(blitter->display, NULL, NULL))
+		goto fail;
+	blitter->initialized = true;
+	const char *extensions = eglQueryString(blitter->display, EGL_EXTENSIONS);
+	*error = "EGL_EXT_image_dma_buf_import is unavailable";
+	if (!has_extension(extensions, "EGL_EXT_image_dma_buf_import"))
+		goto fail;
+	blitter->modifiers = has_extension(extensions, "EGL_EXT_image_dma_buf_import_modifiers");
+
+	*error = "creating a surfaceless GLES 3 context";
+	const EGLint config_attrs[] = {
+		EGL_SURFACE_TYPE, EGL_DONT_CARE,
+		EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT, EGL_NONE,
+	};
+	EGLConfig config;
+	EGLint count;
+	if (!eglBindAPI(EGL_OPENGL_ES_API) ||
+	    !eglChooseConfig(blitter->display, config_attrs, &config, 1, &count) || count == 0)
+		goto fail;
+	blitter->context = create_blit_context(blitter->display, config, extensions);
+	if (blitter->context == EGL_NO_CONTEXT || !bind_blitter(blitter))
+		goto fail;
+
+	*error = "preparing the DMA-BUF shader";
+	blitter->bind_image = (PFNGLEGLIMAGETARGETTEXTURE2DOESPROC)
+		eglGetProcAddress("glEGLImageTargetTexture2DOES");
+	if (!blitter->bind_image || !init_program(blitter))
+		goto fail;
+	*error = "restoring the renderer's EGL context";
+	if (!restore_binding(blitter, binding))
+		goto fail;
+	*error = NULL;
+	return blitter;
+
+fail:
+	if (blitter->context != EGL_NO_CONTEXT)
+		restore_binding(blitter, binding);
+	else
+		eglBindAPI(binding.api);
+	dwl_blitter_destroy(blitter);
+	return NULL;
+}
+
+void dwl_blitter_destroy(struct dwl_blitter *blitter)
+{
+	if (!blitter)
+		return;
+	if (blitter->context != EGL_NO_CONTEXT)
+		eglDestroyContext(blitter->display, blitter->context);
+	if (blitter->initialized)
+		eglTerminate(blitter->display);
+	if (blitter->gbm)
+		gbm_device_destroy(blitter->gbm);
+	if (blitter->fd >= 0)
+		close(blitter->fd);
+	free(blitter);
+}
+
+static struct dwl_blit_image *import_image(struct dwl_blitter *blitter,
+	const struct dwl_blit_dmabuf *desc, bool target, const char **error)
+{
+	*error = "unsupported DMA-BUF size or layout";
+	if (!desc->width || !desc->height || desc->width > INT_MAX || desc->height > INT_MAX ||
+	    desc->stride > INT_MAX || desc->offset > INT_MAX ||
+	    desc->modifier != DRM_FORMAT_MOD_LINEAR)
+		return NULL;
+
+	*error = "allocating the imported image";
+	struct dwl_blit_image *image = calloc(1, sizeof(*image));
+	if (!image)
+		return NULL;
+	struct egl_binding binding = current_binding();
+	*error = "binding the GLES blit context";
+	if (!bind_blitter(blitter))
+		goto fail;
+
+	EGLAttrib attrs[] = {
+		EGL_WIDTH, desc->width, EGL_HEIGHT, desc->height,
+		EGL_LINUX_DRM_FOURCC_EXT, desc->fourcc,
+		EGL_DMA_BUF_PLANE0_FD_EXT, desc->fd,
+		EGL_DMA_BUF_PLANE0_OFFSET_EXT, desc->offset,
+		EGL_DMA_BUF_PLANE0_PITCH_EXT, desc->stride,
+		EGL_NONE, 0, 0, 0, EGL_NONE,
+	};
+	if (blitter->modifiers) {
+		attrs[12] = EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT;
+		attrs[13] = (uint32_t)desc->modifier;
+		attrs[14] = EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT;
+		attrs[15] = desc->modifier >> 32;
+	}
+	*error = target ? "importing the GBM output into EGL" : "importing the guest DMA-BUF into EGL";
+	EGLImage egl_image = eglCreateImage(blitter->display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT,
+					    (EGLClientBuffer)NULL, attrs);
+	if (egl_image == EGL_NO_IMAGE)
+		goto fail;
+
+	glGenTextures(1, &image->texture);
+	glBindTexture(GL_TEXTURE_2D, image->texture);
+	blitter->bind_image(GL_TEXTURE_2D, egl_image);
+	eglDestroyImage(blitter->display, egl_image);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	if (glGetError() != GL_NO_ERROR)
+		goto fail;
+
+	if (target) {
+		*error = "creating a framebuffer for the linear GBM output";
+		glGenFramebuffers(1, &image->framebuffer);
+		glBindFramebuffer(GL_FRAMEBUFFER, image->framebuffer);
+		glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+				       GL_TEXTURE_2D, image->texture, 0);
+		if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE ||
+		    glGetError() != GL_NO_ERROR)
+			goto fail;
+	}
+	*error = "restoring the renderer's EGL context";
+	if (!restore_binding(blitter, binding))
+		goto fail;
+	image->width = desc->width;
+	image->height = desc->height;
+	image->fourcc = desc->fourcc;
+	*error = NULL;
+	return image;
+
+fail:
+	if (eglGetCurrentContext() == blitter->context) {
+		glDeleteFramebuffers(1, &image->framebuffer);
+		glDeleteTextures(1, &image->texture);
+	}
+	restore_binding(blitter, binding);
+	free(image);
+	return NULL;
+}
+
+struct dwl_blit_image *dwl_blitter_import(struct dwl_blitter *blitter,
+	const struct dwl_blit_dmabuf *desc, const char **error)
+{
+	return import_image(blitter, desc, false, error);
+}
+
+struct dwl_blit_image *dwl_blitter_target(struct dwl_blitter *blitter,
+	struct dwl_blit_dmabuf *desc, const char **error)
+{
+	*error = "allocating a linear GBM output";
+	struct gbm_bo *bo = gbm_bo_create(blitter->gbm, desc->width, desc->height, desc->fourcc,
+					  GBM_BO_USE_RENDERING | GBM_BO_USE_LINEAR);
+	if (!bo)
+		return NULL;
+	desc->modifier = gbm_bo_get_modifier(bo);
+	if (gbm_bo_get_plane_count(bo) != 1 || desc->modifier != DRM_FORMAT_MOD_LINEAR) {
+		gbm_bo_destroy(bo);
+		return NULL;
+	}
+	desc->offset = gbm_bo_get_offset(bo, 0);
+	desc->stride = gbm_bo_get_stride_for_plane(bo, 0);
+	*error = "exporting the linear GBM output";
+	desc->fd = gbm_bo_get_fd(bo);
+	if (desc->fd < 0) {
+		gbm_bo_destroy(bo);
+		return NULL;
+	}
+
+	struct dwl_blit_image *image = import_image(blitter, desc, true, error);
+	if (!image) {
+		close(desc->fd);
+		gbm_bo_destroy(bo);
+		return NULL;
+	}
+	image->bo = bo;
+	return image;
+}
+
+void dwl_blitter_free_image(struct dwl_blitter *blitter, struct dwl_blit_image *image)
+{
+	if (!image)
+		return;
+	struct egl_binding binding = current_binding();
+	if (bind_blitter(blitter)) {
+		glDeleteFramebuffers(1, &image->framebuffer);
+		glDeleteTextures(1, &image->texture);
+	}
+	restore_binding(blitter, binding);
+	if (image->bo)
+		gbm_bo_destroy(image->bo);
+	free(image);
+}
+
+bool dwl_blitter_draw(struct dwl_blitter *blitter, const struct dwl_blit_image *source,
+	const struct dwl_blit_image *target, const char **error)
+{
+	struct egl_binding binding = current_binding();
+	*error = "binding the GLES blit context";
+	if (!bind_blitter(blitter)) {
+		restore_binding(blitter, binding);
+		return false;
+	}
+
+	// Both textures address the DMA-BUF rows in the same order. Keep the source
+	// pixels one-to-one and let Wayland/GTK scale the 8-bit scanout.
+	glBindFramebuffer(GL_FRAMEBUFFER, target->framebuffer);
+	glViewport(0, 0, target->width, target->height);
+	glBindTexture(GL_TEXTURE_2D, source->texture);
+	glUniform1i(blitter->half_float, source->fourcc == DRM_FORMAT_ABGR16161616F);
+	glDrawArrays(GL_TRIANGLES, 0, 3);
+
+	GLsync fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+	GLenum result = fence ? glClientWaitSync(fence, GL_SYNC_FLUSH_COMMANDS_BIT, GL_TIMEOUT_IGNORED)
+			      : GL_WAIT_FAILED;
+	if (fence)
+		glDeleteSync(fence);
+	bool ready = result == GL_ALREADY_SIGNALED || result == GL_CONDITION_SATISFIED;
+	// Quiesce even when waiting failed: the CPU fallback and the guest can now
+	// touch the source again. There is no early timeout on a live GPU read.
+	if (!ready)
+		glFinish();
+	ready = glGetError() == GL_NO_ERROR && ready;
+	bool restored = restore_binding(blitter, binding);
+	*error = !restored ? "restoring the renderer's EGL context" :
+		 !ready ? "finishing the GPU scanout blit" : NULL;
+	return restored && ready;
+}
