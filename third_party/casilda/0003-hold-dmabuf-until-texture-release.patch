@@ -2479,6 +2479,7 @@ xdg_toplevel_unmap (struct wl_listener *listener, G_GNUC_UNUSED void *data)
   if (toplevel == toplevel->priv->grabbed_toplevel)
     casilda_compositor_reset_pointer_mode (toplevel->priv);
 
+  g_clear_object (&xdg_toplevel->base->surface->data);
   toplevel->state = NULL;
 
   if (xdg_toplevel->parent)
@@ -2505,14 +2506,20 @@ surface_commit (struct wlr_surface *surface)
   GdkTexture **stored_texture = (GdkTexture **)&surface->data, *new_texture;
 
   if (!surface->mapped)
-    g_clear_object (stored_texture);
+    {
+      g_clear_object (stored_texture);
