+/* Resolve an L1 entry without treating an L0 root as a flat L1 array. */
+static tt_entry_t *
+arm_vm_l1_ttep(tt_entry_t *root, vm_map_address_t va, bool create,
+    bool static_map, uint64_t attrs)
+{
+#if __ARM_4K_L0__
+	tt_entry_t *l0 = root + ((va & ARM_TT_ROOT_INDEX_MASK) >> ARM_TT_ROOT_SHIFT);
+	if (*l0 == ARM_TTE_EMPTY) {
+		assert(create);
+		vm_offset_t page = alloc_ptpage(static_map);
+		bzero((void *)page, ARM_PGBYTES);
+		*l0 = (kvtophys(page) & ARM_TTE_TABLE_MASK) | ARM_TTE_TYPE_TABLE | ARM_TTE_VALID | attrs;
+	}
+	root = (tt_entry_t *)phystokv(*l0 & ARM_TTE_TABLE_MASK);
+#else
+	(void)create; (void)static_map; (void)attrs;
+#endif
+	return root + L1_TABLE_T1_INDEX(va, TCR_EL1_BOOT);
+}
