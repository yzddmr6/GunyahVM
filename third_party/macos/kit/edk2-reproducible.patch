@@ -292,6 +296,16 @@ def GenerateStackCookieValues():
     if GlobalData.gBuildDirectory == "":
         return
 
+    # A reproducible build draws the same values on every build, from SOURCE_DATE_EPOCH.
+    if SourceDateEpochGiven:
+        Seed = ("edk2-stack-cookies:" + os.environ["SOURCE_DATE_EPOCH"]).encode()
+        for Bits in (32, 64):
+            Values = [int.from_bytes(hashlib.sha256(Seed + b":%d:%d" % (Bits, Index)).digest()[:Bits // 8], "little") % ((1 << Bits) - 1)
+                      for Index in range(0, 100)]
+            with open(os.path.join(GlobalData.gBuildDirectory, "StackCookieValues%d.json" % Bits), "w") as file:
+                json.dump(Values, file)
+        return
+
     # Check if the 32 bit values array needs to be created
