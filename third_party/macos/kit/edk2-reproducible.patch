 #include "GenFw.h"
 #include "ElfConvert.h"
+
+//
+// A reproducible build names the time of its sources (SOURCE_DATE_EPOCH) instead of the clock's.
+//
+STATIC
+UINT32
+ImageTimeStamp (
+  VOID
+  )
+{
+  CONST CHAR8  *Epoch;
+
+  Epoch = getenv ("SOURCE_DATE_EPOCH");
+  return Epoch != NULL ? (UINT32) strtoull (Epoch, NULL, 10) : (UINT32) time (NULL);
+}
