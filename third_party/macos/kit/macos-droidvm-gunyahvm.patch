diff --git a/patches/drivers/ArmDTPlatform-psci-power.patch b/patches/drivers/ArmDTPlatform-psci-power.patch
new file mode 100644
index 0000000000000000000000000000000000000000..22ba2769901da1735b913d66af7137dec55d5fd1
--- /dev/null
+++ b/patches/drivers/ArmDTPlatform-psci-power.patch
@@ -0,0 +1,98 @@
+From 108b843579da51550394b124052367637ddfcabc Mon Sep 17 00:00:00 2001
+From: jukfiuune <jukfiuune@gmail.com>
+Date: Tue, 27 Oct 2026 12:09:46 +0200
+Subject: [PATCH] feat(platform): power off and restart through PSCI SYSTEM_OFF
+ and SYSTEM_RESET
+
+ArmDTPlatform had no haltRestart, so after the shutdown notifications the
+generic platform expert had nothing to call, the CPU idled, and
+PEHaltRestart's 30 s timer panicked ("Halt/Restart Timed Out"; seen on
+asteroids at the first shutdown past the root unmount). Halt and UPS-delay
+halt now call PSCI SYSTEM_OFF, restart SYSTEM_RESET, over the conduit the
+device tree's /psci method names (smc or hvc). A refused call is logged and
+falls through to the generic answer; without /psci, and for panic restarts,
+nothing changes, so a panic stays on screen.
+
+[ UniXNU/ArmDTPlatform pull request 2, rebased onto the ArmDTPlatform this tree
+  builds: 0d54470 with ArmDTPlatform-pl030-rtc and ArmDTPlatform-power-hierarchy. ]
+---
+ ArmDTPlatform.cpp | 52 ++++++++++++++++++++++++++++++++++++++++++++++++++++
+ 1 file changed, 52 insertions(+)
+
+diff --git a/ArmDTPlatform.cpp b/ArmDTPlatform.cpp
+index b6d41d0..b233c6c 100644
+--- a/ArmDTPlatform.cpp
++++ b/ArmDTPlatform.cpp
+@@ -38,6 +38,7 @@ public:
+   const char *deleteList (void) override;
+   const char *excludeList (void) override;
+   long getGMTTimeOfDay (void) override;
++  int haltRestart (unsigned int type) override;
+ private:
+   IOMemoryMap *fRTC = nullptr;
+   bool hasNVRAMProxy (IOService *provider);
+@@ -151,6 +152,56 @@ static void platformStageReset (void)
+   for (;;) { __asm__ volatile ("wfe"); }
+ }
+ 
++// The PSCI conduit the device tree's /psci node names (method "smc" or "hvc"); none without the node.
++enum PsciConduit { kPsciNone, kPsciSmc, kPsciHvc };
++static PsciConduit gPsciConduit = kPsciNone;
++
++static PsciConduit psciConduit (IOService *root)
++{
++  IORegistryEntry *psci = root->childFromPath ("psci", gIODTPlane);
++  if (psci == nullptr) { return kPsciNone; }
++  PsciConduit conduit = kPsciNone;
++  OSData *method = OSDynamicCast (OSData, psci->getProperty ("method"));
++  if (method != nullptr && method->getLength () >= 4) {
++    const char *text = static_cast<const char *> (method->getBytesNoCopy ());
++    if (!strncmp (text, "smc", 4)) { conduit = kPsciSmc; }
++    else if (!strncmp (text, "hvc", 4)) { conduit = kPsciHvc; }
++  }
++  psci->release ();
++  return conduit;
++}
++
++// PSCI 0.2 SYSTEM_OFF and SYSTEM_RESET. Neither returns on success; a return means the call was refused, and the caller
++// gets the generic answer.
++static uint64_t psciSystemCall (uint64_t function)
++{
++  register uint64_t x0 __asm__ ("x0") = function;
++  register uint64_t x1 __asm__ ("x1") = 0;
++  register uint64_t x2 __asm__ ("x2") = 0;
++  register uint64_t x3 __asm__ ("x3") = 0;
++  if (gPsciConduit == kPsciHvc) {
++    __asm__ volatile ("hvc #0" : "+r" (x0) : "r" (x1), "r" (x2), "r" (x3) : "memory");
++  } else {
++    __asm__ volatile ("smc #0" : "+r" (x0) : "r" (x1), "r" (x2), "r" (x3) : "memory");
++  }
++  return x0;
++}
++
++// Power off and restart. Without them the generic platform expert has nothing to call, the CPU idles after the shutdown
++// notifications, and PEHaltRestart's 30 s timer panics ("Halt/Restart Timed Out"). Panic restarts are left to the generic
++// path, so a panic stays on screen. A device tree without /psci keeps the generic behaviour.
++int ArmDTPlatform::haltRestart (unsigned int type)
++{
++  if (gPsciConduit != kPsciNone && (type == kPEHaltCPU || type == kPEUPSDelayHaltCPU)) {
++    uint64_t result = psciSystemCall (0x84000008);  // SYSTEM_OFF
++    IOLog ("ArmDTPlatform: PSCI SYSTEM_OFF returned %lld\n", (long long) result);
++  } else if (gPsciConduit != kPsciNone && type == kPERestartCPU) {
++    uint64_t result = psciSystemCall (0x84000009);  // SYSTEM_RESET
++    IOLog ("ArmDTPlatform: PSCI SYSTEM_RESET returned %lld\n", (long long) result);
++  }
++  return IODTPlatformExpert::haltRestart (type);
++}
++
+ bool ArmDTPlatform::configure (IOService *provider)
+ {
+   IORegistryEntry *cpus = provider->childFromPath ("cpus", gIODTPlane);
+@@ -167,6 +218,7 @@ bool ArmDTPlatform::configure (IOService *provider)
+     IOLog ("ArmDTPlatform: required /cpus, /arm-io, /defaults or /options node is absent\n");
+     return false;
+   }
++  gPsciConduit = psciConduit (provider);
+   if (!hasNVRAMProxy (provider)) {
+     IOLog ("ArmDTPlatform: /chosen does not supply a usable CHRP NVRAM proxy\n");
+     return false;
diff --git a/patches/mesa-macos/0003-turnip-darwin-virtgpu-submit-pipe.patch b/patches/mesa-macos/0003-turnip-darwin-virtgpu-submit-pipe.patch
new file mode 100644
index 0000000000000000000000000000000000000000..92e281177dc95b84d939d62b5aaf15115161a2c0
--- /dev/null
+++ b/patches/mesa-macos/0003-turnip-darwin-virtgpu-submit-pipe.patch
@@ -0,0 +1,17 @@
+The darwin virtio GPU backend's submissions on the 3D pipe: msm_ccmd_gem_submit_req's flags are drm_msm_gem_submit's, whose low 16 bits
+name the pipe (MSM_PIPE_ID), and the msm DRM driver takes only MSM_PIPE_3D0 there (msm_ioctl_gem_submit answers "invalid pipe",
+EINVAL). Turnip's own virtio backend sends MSM_PIPE_3D0 (tu_knl_drm_virtio.cc), and so did the plugin GunyahVM 1.5 shipped (the build of
+macOS-DroidVM 524d27b, whose dwv_submit stores 0x10 there); upstream's turnip-darwin-virtgpu.patch leaves the field 0, which drm2kgsl's
+KGSL queues take, but on an msm host every submission was refused, Turnip took that for a lost device and WindowServer found no Metal
+device.
+
+--- a/src/freedreno/vulkan/tu_knl_darwin_virtgpu.cc
++++ b/src/freedreno/vulkan/tu_knl_darwin_virtgpu.cc
+@@ -479,6 +479,7 @@ dwv_submit(const NativeAdrenoAbiSubmit *req, NativeAdrenoAbiSubmitReply *reply)
+    ccmd.header[0] = DWV_CCMD_GEM_SUBMIT;
+    ccmd.header[1] = size;
+    ccmd.header[2] = ++dwv.seqno;
++   ccmd.flags = DWV_MSM_PIPE_3D0;
+    ccmd.queue_id = dwv.queue_id;
+    ccmd.nr_bos = nr_bos;
+    ccmd.nr_cmds = req->buffer_count;
