From aecb70e737098a985ac2619ab651354a240bda68 Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Sat, 7 Nov 2026 23:39:06 +0800
Subject: [PATCH 3/3] arm64: configs: add a protected Gunyah graphics guest
 fragment

Derived from iceland-gvm 7ae498c24e61a8860740d003572455a7443eecd3. Keep RM/virtio60, restricted DMA, GPU, input, 9p and root support; disable the balloon to match the VMM and select Ubuntu AppArmor integration.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 arch/arm64/configs/gvm-3d-guest.config | 151 +++++++++++++++++++++++++
 1 file changed, 151 insertions(+)
 create mode 100644 arch/arm64/configs/gvm-3d-guest.config

diff --git a/arch/arm64/configs/gvm-3d-guest.config b/arch/arm64/configs/gvm-3d-guest.config
new file mode 100644
index 000000000000..0fb7dd2ab749
--- /dev/null
+++ b/arch/arm64/configs/gvm-3d-guest.config
@@ -0,0 +1,151 @@
+# Based on iceland-gvm 7ae498c24e61a8860740d003572455a7443eecd3 guest-kernel/gvm-guest-gg.config.
+# Ubuntu graphics validation guest on Linux 7.2.15; root drivers are built in.
+# gvm-guest.config - fragment on top of arm64 defconfig for a general-purpose Linux guest in a protected
+# Gunyah VM run by crosvm (wf/gvm, 23 Oct 2026). Everything needed to reach the root fs is built in (no initramfs).
+# Protected VM: guest RAM is lent (host cannot read it), so every virtio buffer must bounce through crosvm's
+# restricted-dma-pool (swiotlb) region: CONFIG_DMA_RESTRICTED_POOL is the one option distro kernels lack.
+CONFIG_DMA_RESTRICTED_POOL=y
+CONFIG_SWIOTLB=y
+CONFIG_LOCALVERSION="-gvm61"
+CONFIG_LOCALVERSION_AUTO=n
+CONFIG_IKCONFIG=y
+CONFIG_IKCONFIG_PROC=y
+# crosvm aarch64 machine: GICv3, arch timer, PSCI hvc, 8250 serial, pl030 rtc, generic PCI (CAM), virtio-pci/mmio
+CONFIG_PCI=y
+CONFIG_PCI_HOST_GENERIC=y
+CONFIG_SERIAL_8250=y
+CONFIG_SERIAL_8250_CONSOLE=y
+CONFIG_SERIAL_OF_PLATFORM=y
+CONFIG_RTC_CLASS=y
+CONFIG_RTC_DRV_PL030=y
+CONFIG_RTC_DRV_PL031=y
+CONFIG_VIRTIO=y
+CONFIG_VIRTIO_MENU=y
+CONFIG_VIRTIO_PCI=y
+CONFIG_VIRTIO_MMIO=y
+CONFIG_VIRTIO_BLK=y
+CONFIG_VIRTIO_NET=y
+CONFIG_VIRTIO_CONSOLE=y
+CONFIG_HW_RANDOM=y
+CONFIG_HW_RANDOM_VIRTIO=y
+CONFIG_VIRTIO_INPUT=y
+CONFIG_VIRTIO_BALLOON=n
+CONFIG_VIRTIO_FS=y
+CONFIG_FUSE_FS=y
+CONFIG_NET_9P=y
+CONFIG_NET_9P_VIRTIO=y
+CONFIG_9P_FS=y
+CONFIG_9P_FS_POSIX_ACL=y
+CONFIG_VSOCKETS=y
+CONFIG_VIRTIO_VSOCKETS=y
+# display: virtio-gpu (2D first; 3D/blob needs GuestAccept, later)
+CONFIG_DRM=y
+CONFIG_DRM_VIRTIO_GPU=y
+CONFIG_DRM_VIRTIO_GPU_KMS=y
+CONFIG_DRM_FBDEV_EMULATION=y
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_INPUT_EVDEV=y
+CONFIG_SOUND=y
+CONFIG_SND=y
+CONFIG_SND_VIRTIO=m
+# file systems of the Fedora images (cloud: btrfs root + ext4 /boot + vfat ESP)
+CONFIG_BTRFS_FS=y
+CONFIG_BTRFS_FS_POSIX_ACL=y
+CONFIG_EXT4_FS=y
+CONFIG_EXT4_FS_POSIX_ACL=y
+CONFIG_EXT4_FS_SECURITY=y
+CONFIG_XFS_FS=y
+CONFIG_VFAT_FS=y
+CONFIG_ISO9660_FS=y
+CONFIG_OVERLAY_FS=y
+CONFIG_SQUASHFS=y
+CONFIG_TMPFS=y
+CONFIG_TMPFS_POSIX_ACL=y
+CONFIG_TMPFS_XATTR=y
+CONFIG_AUTOFS_FS=y
+CONFIG_ZRAM=y
+# systemd / Fedora userspace
+CONFIG_CGROUPS=y
+CONFIG_CGROUP_BPF=y
+CONFIG_BPF_SYSCALL=y
+CONFIG_FANOTIFY=y
+CONFIG_USER_NS=y
+CONFIG_AUDIT=y
+CONFIG_SECURITY=y
+CONFIG_SECURITY_NETWORK=y
+CONFIG_SECURITY_SELINUX=y
+CONFIG_DEFAULT_SECURITY_SELINUX=y
+CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor,bpf"
+CONFIG_NF_TABLES=m
+CONFIG_TUN=m
+CONFIG_BRIDGE=m
+CONFIG_VETH=m
+# no hardware: drop what a VM never has to keep the image small
+CONFIG_KVM=n
+CONFIG_VIRTUALIZATION=n
+CONFIG_WLAN=n
+CONFIG_BT=n
+CONFIG_SOUND_OSS_CORE=n
+CONFIG_STAGING=n
+# simplefb software display (iceland-vms 0.2-1, after DroidVM): simpledrm drives the shared framebuffer
+CONFIG_DRM_SIMPLEDRM=y
+# gunyah_guest built in (24 Oct 2026)
+CONFIG_VIRT_DRIVERS=y
+CONFIG_GUNYAH_GUEST=y
+
+CONFIG_DEBUG_INFO_NONE=y
+CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
+CONFIG_SECURITY_APPARMOR=y
+CONFIG_ARCH_ACTIONS=n
+CONFIG_ARCH_AIROHA=n
+CONFIG_ARCH_SUNXI=n
+CONFIG_ARCH_ALPINE=n
+CONFIG_ARCH_APPLE=n
+CONFIG_ARCH_ARTPEC=n
+CONFIG_ARCH_ASPEED=n
+CONFIG_ARCH_AXIADO=n
+CONFIG_ARCH_BCM2835=n
+CONFIG_ARCH_BCM_IPROC=n
+CONFIG_ARCH_BCMBCA=n
+CONFIG_ARCH_BRCMSTB=n
+CONFIG_ARCH_BERLIN=n
+CONFIG_ARCH_BITMAIN=n
+CONFIG_ARCH_BLAIZE=n
+CONFIG_ARCH_BST=n
+CONFIG_ARCH_CIX=n
+CONFIG_ARCH_EXYNOS=n
+CONFIG_ARCH_K3=n
+CONFIG_ARCH_LG1K=n
+CONFIG_ARCH_HISI=n
+CONFIG_ARCH_KEEMBAY=n
+CONFIG_ARCH_MEDIATEK=n
+CONFIG_ARCH_MESON=n
+CONFIG_ARCH_LAN969X=n
+CONFIG_ARCH_SPARX5=n
+CONFIG_ARCH_MMP=n
+CONFIG_ARCH_MVEBU=n
+CONFIG_ARCH_LAYERSCAPE=n
+CONFIG_ARCH_MXC=n
+CONFIG_ARCH_S32=n
+CONFIG_ARCH_MA35=n
+CONFIG_ARCH_NPCM=n
+CONFIG_ARCH_PENSANDO=n
+CONFIG_ARCH_QCOM=n
