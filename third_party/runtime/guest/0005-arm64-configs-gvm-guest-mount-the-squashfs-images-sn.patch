From 137462c33733324175c03e414d12bd2d45d997f3 Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Tue, 10 Nov 2026 20:59:51 +0800
Subject: [PATCH] arm64: configs: gvm guest: mount the squashfs images snaps
 ship

Ubuntu installs Firefox as a snap. snapd first checks that the kernel
can mount an xz-compressed squashfs image and refuses to install any
snap otherwise, so the first-boot desktop setup of an Ubuntu guest
failed in the firefox package's preinst. Enable the xz, zstd, lz4 and
lzo decompressors and squashfs xattrs (the decompressor libraries are
already built in), and bump the guest ABI to gvm63.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/configs/gvm-3d-guest.config | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/configs/gvm-3d-guest.config b/arch/arm64/configs/gvm-3d-guest.config
index ea76799d04f6..6a4582b418e9 100644
--- a/arch/arm64/configs/gvm-3d-guest.config
+++ b/arch/arm64/configs/gvm-3d-guest.config
@@ -6,7 +6,7 @@
 # restricted-dma-pool (swiotlb) region: CONFIG_DMA_RESTRICTED_POOL is the one option distro kernels lack.
 CONFIG_DMA_RESTRICTED_POOL=y
 CONFIG_SWIOTLB=y
-CONFIG_LOCALVERSION="-gvm62"
+CONFIG_LOCALVERSION="-gvm63"
 CONFIG_LOCALVERSION_AUTO=n
 CONFIG_IKCONFIG=y
 CONFIG_IKCONFIG_PROC=y
@@ -59,6 +59,13 @@ CONFIG_VFAT_FS=y
 CONFIG_ISO9660_FS=y
 CONFIG_OVERLAY_FS=y
 CONFIG_SQUASHFS=y
+# Snaps (Ubuntu's Firefox among them) ship xz squashfs images; snapd checks the
+# kernel can mount them before installing any snap.
+CONFIG_SQUASHFS_XATTR=y
+CONFIG_SQUASHFS_XZ=y
+CONFIG_SQUASHFS_ZSTD=y
+CONFIG_SQUASHFS_LZ4=y
+CONFIG_SQUASHFS_LZO=y
 CONFIG_TMPFS=y
 CONFIG_TMPFS_POSIX_ACL=y
 CONFIG_TMPFS_XATTR=y
-- 
2.43.0

