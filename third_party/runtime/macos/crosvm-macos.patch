+/* Adapted from iceland-gvm gvm_to_buffer_axis: the Wayland seat reports
+ * surface coordinates, while virtio-input is sized in framebuffer pixels.
+ * Match this backend's viewport destination (or integer buffer scale). */
+static int32_t gvm_to_buffer_axis(struct wl_surface *surface, wl_fixed_t value, int axis)
+{
+    double scale = 1.0;
+    if (surface) {
+        struct dwl_surface *ds = wl_surface_get_user_data(surface);
+        if (ds && ds->scale > 0) {
+            double pixels = axis == 0 ? ds->width : ds->height;
+            scale = ds->viewport ? pixels / ceil(pixels / ds->scale) : (int)ds->scale;
+        }
+    }
+    return (int32_t)(wl_fixed_to_double(value) * scale);
+}
