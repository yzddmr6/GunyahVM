+/// Prepare the shim's boot RAM before starting its vCPUs. The RM must map
+/// this whole region into stage 2. Fragmented windows can still fit in the
+/// RM's page tables; the shim reports the authoritative admission result.
+pub unsafe fn prepare_boot_window(base: *mut u8, len: u64) -> std::io::Result<()> {
+    if len == 0 || len % THP_SIZE != 0 || (base as usize) % THP_SIZE as usize != 0 {
+        return Err(std::io::Error::from_raw_os_error(libc::EINVAL));
+    }
+    let coverage = fold_mapped_range(base, len)?;
+    info!(
+        "Gunyah boot RAM: {} of {} windows backed by 2 MiB folios",
+        coverage.collapsed, coverage.windows
+    );
+    if libc::mlock(base.cast(), len as usize) != 0 {
+        return Err(std::io::Error::last_os_error());
+    }
+    clean_dcache_to_poc(base, len as usize);
+    Ok(())
+}
