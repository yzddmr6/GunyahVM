+    fn import_resource_for_blit(
+        display: &Rc<RefCell<GpuDisplay>>,
+        surface_id: u32,
+        resource: &VirtioGpuResource,
+    ) -> anyhow::Result<u32> {
+        let descriptor = resource.pool_scanout_dmabuf.as_ref()
+            .context("guest scanout has no udmabuf")?;
+        let data = resource.scanout_data.context("guest scanout has no blob geometry")?;
+        let fourcc = u32::from(data.drm_format);
+        let bytes_per_pixel = if fourcc == DRM_FORMAT_ABGR16161616F {
+            8
+        } else if is_single_plane_8888_rgb(fourcc) {
+            4
+        } else {
+            anyhow::bail!("unsupported guest scanout fourcc {fourcc:#x}");
+        };
+
+        let stride = u64::from(data.strides[0]);
+        let row_bytes = u64::from(data.width) * bytes_per_pixel;
+        let end = u64::from(data.height)
+            .checked_sub(1)
+            .and_then(|rows| rows.checked_mul(stride))
+            .and_then(|span| span.checked_add(u64::from(data.offsets[0])))
+            .and_then(|offset| offset.checked_add(row_bytes));
+        if data.width == 0 || row_bytes > stride || !end.is_some_and(|end| end <= resource.size) {
+            anyhow::bail!("invalid linear layout for guest scanout fourcc {fourcc:#x}");
+        }
+
+        display.borrow_mut().import_resource_for_blit(
+            surface_id,
+            DisplayExternalResourceImport::Dmabuf {
+                descriptor,
+                offset: data.offsets[0],
+                stride: data.strides[0],
+                modifiers: DRM_FORMAT_MOD_LINEAR,
+                linear_layout_verified: true,
+                width: data.width,
+                height: data.height,
+                fourcc,
+            },
+        )
