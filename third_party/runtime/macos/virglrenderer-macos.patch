diff --git a/src/drm/drm_shmem_pool.c b/src/drm/drm_shmem_pool.c
new file mode 100644
index 0000000000000000000000000000000000000000..79bca11efd31e0109c63fe19bbf9c0f21e46f9a3
--- /dev/null
+++ b/src/drm/drm_shmem_pool.c
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: MIT
+ * Reuses the VMM arena ABI introduced by Droid-VM's drm2kgsl backend.
+ * Native DRM contexts need the same pre-shared transport on Gunyah.
+ */
+#include "config.h"
+#include "drm_shmem_pool.h"
+#include "virglrenderer.h"
+#include "util/os_file.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static struct {
+   pthread_mutex_t lock;
+   unsigned char *base, *used;
+   uint64_t pages, fd_offset;
+   size_t page;
+   int fd;
+   bool initialized;
+} pool = { .lock = PTHREAD_MUTEX_INITIALIZER, .fd = -1 };
+
+static bool env_u64(const char *name, uint64_t *out)
+{
+   const char *s = getenv(name);
+   char *end;
+   if (!s || !*s || *s == '-') return false;
+   errno = 0;
+   *out = strtoull(s, &end, 0);
+   return !errno && !*end;
+}
+
+bool drm_shmem_pool_configured(void)
+{
+   return getenv("CROSVM_DRM2KGSL_ARENA_FD") != NULL;
+}
+
+static int init_locked(void)
+{
+   if (pool.initialized) return pool.used ? 0 : -EINVAL;
+   pool.initialized = true;
+   uint64_t fd, va, size, offset = 0;
+   pool.page = getpagesize();
+   if (!env_u64("CROSVM_DRM2KGSL_ARENA_FD", &fd) || fd > INT_MAX ||
+       !env_u64("CROSVM_DRM2KGSL_ARENA_HOST_VA", &va) || !va ||
+       !env_u64("CROSVM_DRM2KGSL_ARENA_SIZE", &size) || !size ||
+       ((va | size) & (pool.page - 1)) || fcntl(fd, F_GETFD) < 0)
+      return -EINVAL;
+   if (getenv("CROSVM_DRM2KGSL_ARENA_FD_OFFSET") &&
+       !env_u64("CROSVM_DRM2KGSL_ARENA_FD_OFFSET", &offset)) return -EINVAL;
+   if ((offset & (pool.page - 1)) || size > UINT64_MAX - offset) return -EINVAL;
+   pool.pages = size / pool.page;
+   pool.used = calloc(pool.pages, 1);
+   if (!pool.used) return -ENOMEM;
+   pool.fd = fd;
+   pool.base = (void *)(uintptr_t)va;
+   pool.fd_offset = offset;
+   return 0;
+}
+
+int drm_shmem_pool_alloc(uint64_t bytes, struct virgl_context_blob *blob)
+{
+   pthread_mutex_lock(&pool.lock);
+   int ret = init_locked();
+   if (ret) goto out;
+   if (!bytes || bytes > UINT64_MAX - pool.page + 1) { ret = -EINVAL; goto out; }
+   const uint64_t count = (bytes + pool.page - 1) / pool.page;
+   uint64_t run = 0, start = 0;
+   for (uint64_t i = 0; i < pool.pages; i++) {
+      run = pool.used[i] ? 0 : run + 1;
+      if (run == count) { start = i + 1 - count; break; }
+   }
+   if (run != count) { ret = -ENOMEM; goto out; }
+   int fd = os_dupfd_cloexec(pool.fd);
+   if (fd < 0) { ret = -errno; goto out; }
+   memset(pool.used + start, 1, count);
+   void *ptr = pool.base + start * pool.page;
+   memset(ptr, 0, count * pool.page);
+   blob->type = VIRGL_RESOURCE_FD_SHM;
+   blob->u.fd = fd;
+   blob->map_ptr = ptr;
+   blob->fd_offset = pool.fd_offset + start * pool.page;
+   blob->map_info = VIRGL_RENDERER_MAP_CACHE_CACHED;
+out:
+   pthread_mutex_unlock(&pool.lock);
+   return ret;
+}
+
+void drm_shmem_pool_free(void *ptr, uint64_t bytes)
+{
+   pthread_mutex_lock(&pool.lock);
+   uint64_t start = ((unsigned char *)ptr - pool.base) / pool.page;
+   uint64_t count = (bytes + pool.page - 1) / pool.page;
+   if (start < pool.pages && count <= pool.pages - start)
+      memset(pool.used + start, 0, count);
+   pthread_mutex_unlock(&pool.lock);
+}
