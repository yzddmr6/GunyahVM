+            // Tablet input mode: the pointer is an absolute pointer with buttons and wheel.
+            DWL_EVENT_TYPE_POINTER_MOVE => Some(GpuDisplayEvents {
+                events: vec![
+                    virtio_input_event::absolute_x(max(0, event.params[0])),
+                    virtio_input_event::absolute_y(max(0, event.params[1])),
+                ],
+                device_type: EventDeviceKind::Tablet,
+            }),
+            DWL_EVENT_TYPE_POINTER_BUTTON => {
+                let down = event.params[1] != 0;
+                let click = match event.params[0] as u16 {
+                    linux_input_sys::constants::BTN_LEFT => virtio_input_event::left_click(down),
+                    linux_input_sys::constants::BTN_RIGHT => virtio_input_event::right_click(down),
+                    linux_input_sys::constants::BTN_MIDDLE => virtio_input_event::middle_click(down),
+                    _ => return None,
+                };
+                Some(GpuDisplayEvents {
+                    events: vec![click],
+                    device_type: EventDeviceKind::Tablet,
+                })
+            }
+            DWL_EVENT_TYPE_POINTER_AXIS => {
+                // Wayland scrolls down/right for positive values; REL_WHEEL is positive upwards.
+                let wheel = if event.params[0] == 0 {
+                    virtio_input_event::wheel(-event.params[1])
+                } else {
+                    virtio_input_event::relative(linux_input_sys::constants::REL_HWHEEL, event.params[1])
+                };
+                Some(GpuDisplayEvents {
+                    events: vec![wheel],
+                    device_type: EventDeviceKind::Tablet,
+                })
+            }
