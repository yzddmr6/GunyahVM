+    #[test]
+    fn converts_half_float_rgba_to_opaque_bytes() {
+        // 0.0, 0.5, 1.0, 2.0 | -1.0, NaN, 0.25, 0.0 (alpha ignored)
+        let halves: [u16; 8] = [0x0000, 0x3800, 0x3c00, 0x4000, 0xbc00, 0x7e00, 0x3400, 0x0000];
+        let source: Vec<u8> = halves.iter().flat_map(|h| h.to_le_bytes()).collect();
