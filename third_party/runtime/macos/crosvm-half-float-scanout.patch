+    #[test]
+    fn half_to_byte_rounds_every_byte_step() {
+        for byte in 0..=255u32 {
+            // The half float nearest byte / 255 converts back to the same byte.
+            let value = byte as f32 / 255.0;
+            let bits = value.to_bits();
+            let exponent = ((bits >> 23) & 0xff) as i32 - 127 + 15;
+            let half = if byte == 0 {
+                0
+            } else if exponent <= 0 {
+                ((value * 16_777_216.0).round()) as u16
+            } else {
+                let mantissa = ((bits & 0x7f_ffff) + (1 << 12)) >> 13;
+                (((exponent as u32) << 10) + mantissa) as u16
+            };
+            assert_eq!(u32::from(half_to_byte(half)), byte, "half {half:#06x}");
+            assert_eq!(u32::from(half_to_byte_table()[usize::from(half >> 2)]), byte);
+        }
+    }
