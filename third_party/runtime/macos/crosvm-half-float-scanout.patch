+/// A half float's value in [0, 1] as a byte: negative and NaN are 0, 1.0 and above 255, the rest
+/// rounded to the nearest step. No transfer function: macOS's display kext converts 'RGhA' surfaces
+/// for its own boot framebuffer the same way, and they are drawn in the display's sRGB encoding.
+fn half_to_byte(half: u16) -> u8 {
+    let exponent = u32::from((half >> 10) & 31);
+    let mantissa = u32::from(half & 1023);
+    if half & 0x8000 != 0 || (exponent == 31 && mantissa != 0) {
+        return 0;
+    }
+    if exponent >= 15 {
+        return 255;
+    }
+    // value * 255 = scaled * 2^(exponent - 25); subnormals are mantissa * 2^-24.
+    let scaled = if exponent != 0 { 1024 + mantissa } else { mantissa } * 255;
+    let shift = if exponent != 0 { 25 - exponent } else { 24 };
+    ((scaled + (1 << (shift - 1))) >> shift) as u8
+}
+
+/// `half_to_byte` of every half float with its two lowest mantissa bits dropped (the index is the
+/// half float >> 2): 16 KiB, which stays in the L1 cache where all 65536 values would not, and
+/// eight mantissa bits are still finer than a byte's step anywhere in [0, 1].
+fn half_to_byte_table() -> &'static [u8; 16384] {
+    static TABLE: OnceLock<Box<[u8; 16384]>> = OnceLock::new();
+    TABLE.get_or_init(|| {
+        let mut table = Box::new([0u8; 16384]);
+        for (index, byte) in table.iter_mut().enumerate() {
+            *byte = half_to_byte((index << 2 | 2) as u16);
+        }
+        table
+    })
+}
