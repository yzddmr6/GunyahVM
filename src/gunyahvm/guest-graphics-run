# Environment selection follows the iceland-gvm native guest test recipe.
"""Run an explicitly selected native guest process/session with private Mesa."""

import os
from pathlib import Path
import subprocess
import sys

PREFIX = Path("/usr/lib/gunyahvm/guest-mesa")


def environment(mode, prefix=PREFIX, icd_directory=Path("/usr/share/vulkan/icd.d")):
    if mode == "virgl":
        return {"VIRGL_DEBUG": "nocoherent"}
    if mode == "venus":
        icds = list(icd_directory.glob("virtio*.json"))
        if len(icds) != 1:
            raise ValueError(
                "Venus requires exactly one distribution virtio Vulkan ICD"
            )
        return {
            "VK_DRIVER_FILES": str(icds[0]),
            "VK_ICD_FILENAMES": str(icds[0]),
            "VIRGL_DEBUG": "nocoherent",
        }
    return {
        "LD_LIBRARY_PATH": str(prefix / "lib"),
        "LIBGL_DRIVERS_PATH": str(prefix / "lib/dri"),
        "GBM_BACKENDS_PATH": str(prefix / "lib/gbm"),
        "__EGL_VENDOR_LIBRARY_FILENAMES": str(
            prefix / "share/glvnd/egl_vendor.d/50_mesa.json"
        ),
        "VK_DRIVER_FILES": str(
            prefix / "share/vulkan/icd.d/freedreno_icd.aarch64.json"
        ),
        "FD_MESA_DEBUG": "noubwc,notile",
        "__GLX_VENDOR_LIBRARY_NAME": "mesa",
        "VK_ICD_FILENAMES": str(
            prefix / "share/vulkan/icd.d/freedreno_icd.aarch64.json"
        ),
    }


def main(argv):
    if not argv or argv[0] not in ("--virgl", "--venus", "--native"):
        raise SystemExit(
            "Usage: gunyahvm-graphics-run --virgl|--venus|--native COMMAND [ARG ...]"
        )
    mode, argv = argv[0][2:], argv[1:]
    if mode == "native" and not (PREFIX / "lib/libvulkan_freedreno.so").is_file():
        raise SystemExit(
            "Select native graphics and start the guest before using native Mesa"
        )
    desktop = argv[:1] == ["--desktop"]
    command = ["gnome-session", "--session=ubuntu"] if desktop else argv
    if not command:
        raise SystemExit("A command is required")
    selected = environment(mode)
    env = os.environ | selected
    if not desktop:
        os.execvpe(command[0], command, env)
    # GNOME launches applications through the per-user service/DBus managers.
    # Scope the selection to this explicit desktop session, never ld.so.conf.
    subprocess.run(
        ["dbus-update-activation-environment", "--systemd", *selected],
        env=env,
        check=True,
    )
    try:
        return subprocess.call(command, env=env)
    finally:
        restore = {key: os.environ.get(key, "") for key in selected}
        subprocess.run(
            ["dbus-update-activation-environment", "--systemd", *selected],
            env=os.environ | restore,
            check=False,
        )


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
