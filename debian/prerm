#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026 yzddMr6
set -e
case "$1" in
    remove|upgrade|deconfigure)
        /usr/bin/python3 -IB - <<'PY'
import os
from pathlib import Path
for process in Path('/proc').glob('[0-9]*'):
    try:
        executable = os.readlink(process / 'exe')
        running = executable.removesuffix(' (deleted)') in (
            '/usr/lib/gunyahvm/crosvm/crosvm', '/usr/lib/gunyahvm/macos/crosvm/crosvm')
        if not running:
            with (process / 'cmdline').open('rb') as stream:
                running = b'/usr/lib/gunyahvm/python/gunyahvm/supervisor.py' in stream.read(4096).split(b'\0')
        if running:
            raise SystemExit('Stop virtual machines before changing the gunyahvm package.')
    except OSError:
        pass
PY
        # Bytecode is not part of the package: leave none for the next version
        # to reuse, and none behind after removal (see postinst).
        modules="${DPKG_ROOT:-}/usr/lib/gunyahvm/python"
        if [ -d "$modules" ]; then
            find "$modules" -type d -name __pycache__ -prune -exec rm -rf -- {} +
        fi
        ;;
esac
