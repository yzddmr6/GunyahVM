msgstr "macOS 账户"

#: src/gunyahvm/ui/wizard.py
msgid "You sign in to macOS with this account. It is an administrator."
msgstr "用这个账户登录 macOS，它是管理员。"

#: src/gunyahvm/ui/wizard.py
msgid "Account Name"
msgstr "账户名"

#: src/gunyahvm/ui/wizard.py
msgid "Password"
msgstr "密码"

#: src/gunyahvm/ui/wizard.py
msgid "Confirm Password"
msgstr "确认密码"

#: src/gunyahvm/ui/wizard.py
msgid "Storage"
msgstr "存储"

#: src/gunyahvm/ui/wizard.py
msgid "Disk Size (GB)"
msgstr "磁盘大小（GB）"

#: src/gunyahvm/ui/wizard.py
msgid "Keep the Downloaded Files"
msgstr "保留下载的文件"

#: src/gunyahvm/ui/wizard.py
msgid "Creates another macOS VM without downloading again. Uses about 13 GB."
msgstr "再建一台 macOS 虚拟机时不用重新下载。占用约 13 GB。"

#: src/gunyahvm/ui/wizard.py
msgid "Import a boot bundle assembled earlier"
msgstr "导入之前组装好的启动包"

#: src/gunyahvm/ui/wizard.py
msgid "Local Boot Bundle"
msgstr "本地启动包"

#: src/gunyahvm/ui/wizard.py
msgid "No file chosen"
msgstr "未选择文件"

#: src/gunyahvm/ui/wizard.py
msgid "_Choose…"
msgstr "选择…"

#: src/gunyahvm/ui/wizard.py
msgid "Choose a Boot Bundle"
msgstr "选择启动包"

#: src/gunyahvm/ui/wizard.py
msgid "C_reate"
msgstr "创建"

#: src/gunyahvm/ui/wizard.py
#, python-brace-format
msgid "{size} GB free on this device; about 27 GB are needed while it is created"
msgstr "本机可用 {size} GB；创建过程中约需 27 GB"

#: src/gunyahvm/ui/wizard.py
msgid "This bundle needs to be rebuilt with the native APFS layout."
msgstr "此启动包需要使用原生 APFS 布局重新构建。"

#: src/gunyahvm/ui/wizard.py
#, python-brace-format
msgid "{memory} MiB · {cpus} processors"
msgstr "{memory} MiB · {cpus} 个处理器"

#: src/gunyahvm/ui/wizard.py
msgid "Couldn't Open the Bundle"
msgstr "无法打开启动包"

#: src/gunyahvm/ui/wizard.py
msgid "_Import"
msgstr "导入(_I)"

#: src/gunyahvm/ui/wizard.py
msgid "Windows ISO"
msgstr "Windows ISO"

#: src/gunyahvm/ui/wizard.py
msgid "Disk Image"
msgstr "磁盘镜像"

#: src/gunyahvm/ui/wizard.py
msgid "Download"
msgstr "下载"

#: src/gunyahvm/ui/wizard.py
msgid "Source"
msgstr "下载源"

#: src/gunyahvm/ui/wizard.py
msgid "Checksums always come from Ubuntu's official servers."
msgstr "校验值始终来自 Ubuntu 官方服务器。"

#: src/gunyahvm/ui/wizard.py
msgid "Windows Account"
msgstr "Windows 账户"

#: src/gunyahvm/ui/wizard.py
msgid "Windows is installed offline with this local account. No Microsoft account is needed."
msgstr "Windows 会离线安装并使用这个本地账户，不需要 Microsoft 账户。"

#: src/gunyahvm/ui/wizard.py
msgid "User Name"
msgstr "用户名"

#: src/gunyahvm/ui/wizard.py
msgid "With graphics on, Ubuntu is set up with a desktop."
msgstr "开启图形时，Ubuntu 会附带桌面。"

#: src/gunyahvm/ui/wizard.py
msgid "Graphics need a desktop installed in the image."
msgstr "镜像中需要已装好桌面才能显示图形。"

#: src/gunyahvm/ui/wizard.py
msgid "Edition"
msgstr "版本"

#: src/gunyahvm/ui/wizard.py
msgid "Windows edition to install"
msgstr "要安装的 Windows 版本"

#: src/gunyahvm/ui/wizard.py
#, python-brace-format
msgid "{size} GB free on this device"
msgstr "这台设备剩余 {size} GB"

#: src/gunyahvm/ui/wizard.py
msgid "Choose a Windows ISO"
msgstr "选择 Windows ISO"

#: src/gunyahvm/ui/wizard.py
msgid "Choose a Disk Image"
msgstr "选择磁盘镜像"

#: src/gunyahvm/ui/wizard.py
msgid "ISO Images"
msgstr "ISO 镜像"

#: src/gunyahvm/ui/wizard.py
msgid "Disk Images"
msgstr "磁盘镜像"

#: src/gunyahvm/ui/wizard.py
msgid "All Files"
msgstr "所有文件"

#: src/gunyahvm/ui/wizard.py
msgid "This file isn't an ISO image."
msgstr "这个文件不是 ISO 镜像。"

#: src/gunyahvm/ui/wizard.py
msgid "This file isn't a raw or qcow2 disk image."
msgstr "这个文件不是 raw 或 qcow2 磁盘镜像。"

#: src/gunyahvm/ui/wizard.py
msgid "Use lowercase letters, digits and hyphens, starting with a letter."
msgstr "使用小写字母、数字和连字符，并以字母开头。"
