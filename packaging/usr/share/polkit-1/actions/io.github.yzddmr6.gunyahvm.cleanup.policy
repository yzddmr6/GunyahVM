<policyconfig>
  <vendor>GunyahVM</vendor>
  <action id="io.github.yzddmr6.gunyahvm.cleanup">
    <description>Remove your own virtual machine network</description>
    <message>Remove only the calling user's UUID-derived TAP</message>
    <defaults><allow_any>yes</allow_any><allow_inactive>yes</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/gunyahvm/gunyahvm-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">net-down</annotate>
  </action>
</policyconfig>
