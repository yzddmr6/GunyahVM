abi <abi/4.0>,
include <tunables/global>
# Only grant the installed VMM the userns permission needed by its minijail workers.
# Filesystem/syscall isolation is implemented by crosvm; this is not an AppArmor jail.
profile gunyahvm-crosvm /usr/lib/gunyahvm/crosvm/crosvm flags=(unconfined) {
  userns,
}
